#!/bin/bash
# Sign a runtime image and attach its compliance bundle to the digest.
#
# Keyless: `cosign sign` uses the GitHub Actions OIDC token, exchanges it at Fulcio
# for a short-lived certificate and records the signature in Rekor. There is no
# long-lived key to leak, and the certificate names the workflow that produced the
# image — which is the property an ATO reviewer is actually asking about.
#
#   attest-container <runtime_id> <arch> [--target standard|soci|merged|merged-soci]
#                                     [--key <path>] [--sign-only] [--refresh-dynamic]
#
#   --target     which published reference to attest: the per-arch image (default),
#                its SOCI copy, the merged multi-arch index, or the merged SOCI one.
#   --sign-only  sign the digest without attaching the bundle; the merged index has
#                no artifacts of its own.
#   --refresh-dynamic
#                replace the CVE report and provenance referrers with the fresh ones
#                and delete the referrer each one supersedes, so a re-scan updates
#                the evidence in place instead of adding to it. Without the flag an
#                existing dynamic referrer is left alone, which keeps a re-release at
#                exactly one of each.
#
# Outside CI (or without `id-token: write`) there is no OIDC token, so the script
# records that and exits 0 rather than pretending it signed anything. A local build
# still produces the artifacts; it just cannot attest them.
set -euo pipefail

source "$(dirname "$0")/_common.sh"

key=""
target="standard"
sign_only=0
refresh_dynamic=0
positional=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --key) key=${2:-}; shift 2 ;;
        --target) target=${2:-}; shift 2 ;;
        --sign-only) sign_only=1; shift ;;
        --refresh-dynamic) refresh_dynamic=1; shift ;;
        -*) echo "Unknown option: $1" >&2; exit 2 ;;
        *) positional+=("$1"); shift ;;
    esac
done

runtime_id=$(common::require_runtime_id "${positional[0]:-}")
arch=$(common::require_arch "${positional[1]:-}")
common::load_runtime_env "${runtime_id}" "${arch}"

# Each published reference is signed and attested on its own: the per-arch image,
# its SOCI copy, and the multi-arch index that combines them. A consumer verifies
# whatever digest it pulls, so none of them may be left unsigned.
case "${target}" in
    standard) tag="${CONTAINER_TAG}-${CONTAINER_ARCH}" ;;
    soci) tag="${CONTAINER_TAG}-${CONTAINER_ARCH}${CONTAINER_SOCI_SUFFIX}" ;;
    merged) tag="${CONTAINER_TAG}" ;;
    merged-soci) tag="${CONTAINER_TAG}${CONTAINER_SOCI_SUFFIX}" ;;
    *) echo "Unknown target: ${target} (standard, soci, merged, merged-soci)" >&2; exit 2 ;;
esac

if ! type -P cosign >/dev/null; then
    echo "Install cosign to sign and attest: https://docs.sigstore.dev/cosign/installation/" >&2
    exit 1
fi
if ! type -P oras >/dev/null; then
    echo "Install oras to resolve the digest and attach the bundle: https://oras.land/docs/installation" >&2
    exit 1
fi

compliance_dir="${ARTIFACT_DIR}/compliance"
stem="${compliance_dir}/${runtime_id}-${arch}"
# The multi-arch index has no artifact of its own: each platform manifest carries
# its bundle, and the index is signed so a consumer that pulls the tag and
# verifies the resolved digest has something to check.
if (( ! sign_only )); then
    for artifact in "${stem}.spdx.json" "${stem}.cdx.json" "${stem}.grype.json" "${stem}.provenance.json"; do
        if [[ ! -f "${artifact}" ]]; then
            echo "Missing ${artifact}: run generate-compliance-artifacts first" >&2
            exit 1
        fi
    done
fi

sign_args=(sign --yes)
if [[ -n "${key}" ]]; then
    sign_args=(sign --yes --key "${key}")
elif [[ -z "${ACTIONS_ID_TOKEN_REQUEST_TOKEN:-}" && -z "${SIGSTORE_ID_TOKEN:-}" ]]; then
    echo "::notice::no OIDC token in this environment, so ${runtime_id} (${arch}) was not signed; keyless signing runs in CI"
    exit 0
fi

case "${target}" in
    soci | merged-soci)
        # A SOCI copy is published only to the registries Lambda can read it from,
        # so asking every registry for the tag would fail on the ones that never
        # received it.
        mapfile -t registries < <(common::soci_registries)
        if [[ ${#registries[@]} -eq 0 ]]; then
            echo "::notice::${runtime_id} (${arch}) ${tag}: no SOCI registry configured, nothing to attest"
            exit 0
        fi
        ;;
    *)
        mapfile -t registries < <(python3 -c 'import json,sys
for registry in json.loads(sys.argv[1]): print(registry)' "${CONTAINER_REGISTRIES_OVERRIDE:-${CONTAINER_REGISTRIES}}")
        ;;
esac

SIGNATURE_TYPE="application/vnd.dev.sigstore.bundle.v0.3+json"
# The two artifacts that describe a *scan*, not the image bytes. They are the ones
# an operator refreshes when Grype's database moves; the SBOMs are bound to the
# image and never rewritten for the same digest.
GRYPE_TYPE="application/vnd.grype.report.v1+json"
PROVENANCE_TYPE="application/vnd.lambda-runtime.provenance.v1+json"

# Referrers already on a digest, as "<artifactType>\t<digest>" lines. Re-running a
# release over an unchanged image produces the same digest, and both `oras attach`
# and `cosign sign` append rather than replace — so a second run would double every
# referrer. Reading what is present also heals a run that attached some artifacts
# and then failed: only the missing ones are written. The digests are kept because
# replacing a dynamic artifact means deleting the one it supersedes.
present_referrers() {
    oras discover --format json "$1" 2>/dev/null \
        | python3 -c 'import json, sys
try:
    document = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for referrer in document.get("referrers") or []:
    print("{}\t{}".format(referrer.get("artifactType", ""), referrer.get("digest", "")))' || true
}

type_present() {  # type_present <artifactType> <referrers>
    grep -qF "$1"$'\t' <<<"$2"
}

# Delete every referrer of one type except the newest, which is the one just
# attached. The newest is read from the registry rather than assumed: attaching
# identical bytes produces the same referrer digest, so "the new one" can legitimately
# be the referrer that was already there — and deleting it would leave the digest with
# no CVE report at all.
prune_superseded() {  # prune_superseded <artifactType> <reference> <referrers-file>
    local media=$1 reference=$2 file=$3 plan superseded
    oras discover --format json "${reference}" > "${file}" 2>/dev/null || return 0
    plan=$(python3 - "${file}" "${media}" <<'PY'
import json
import sys

path, media = sys.argv[1:3]
try:
    with open(path, encoding="utf-8") as handle:
        document = json.load(handle)
except Exception:
    sys.exit(0)

entries = [
    ((referrer.get("annotations") or {}).get("org.opencontainers.image.created", ""),
     referrer.get("digest", ""))
    for referrer in document.get("referrers") or []
    if referrer.get("artifactType") == media
]
entries.sort()
for _created, digest in entries[:-1]:
    print(digest)
PY
)
    while read -r superseded; do
        [[ -n "${superseded}" ]] || continue
        if common::delete_referrer "${repository}" "${superseded}"; then
            echo "Pruned superseded ${media} referrer ${superseded} on ${reference}"
        else
            echo "::warning::could not prune ${superseded}; ${reference} carries two ${media} referrers" >&2
        fi
    done <<< "${plan}"
}

for registry in "${registries[@]}"; do
    repository="${registry}/${RUNTIME_ID}"
    tag_reference="${repository}:${tag}"

    # A tag is mutable, so a signature over it says nothing about the bytes a
    # consumer pulls later: the tag can be repointed between the push and the
    # pull. Resolve it once, here, and pin every signature and attachment to the
    # digest the registry is serving right now.
    digest=$(oras manifest fetch --descriptor "${tag_reference}" 2>/dev/null \
        | python3 -c 'import json, sys
try:
    print(json.load(sys.stdin)["digest"])
except Exception:
    sys.exit(1)') || {
        echo "Cannot resolve ${tag_reference} to a digest; push the image first" >&2
        exit 1
    }
    reference="${repository}@${digest}"

    present=$(present_referrers "${reference}")

    if type_present "${SIGNATURE_TYPE}" "${present}"; then
        echo "Skipping cosign sign on ${reference} (signature already attached)"
    else
        echo "Signing ${reference}"
        cosign "${sign_args[@]}" "${reference}"
    fi

    # `oras attach` for every artifact rather than cosign's per-type subcommands:
    # the media type travels with the blob, so `oras discover` lists the whole set
    # and a consumer picks the format it ingests. The paths are relative because
    # oras refuses an absolute path by default: a reference must not leak the
    # layout of the host that produced it.
    if (( ! sign_only )); then
        (
            cd "${compliance_dir}"
            attach_artifact() {  # attach_artifact <file> <media-type> <replace:0|1>
                if (( $3 == 0 )) && type_present "$2" "${present}"; then
                    echo "Skipping $2 on ${reference} (already attached)"
                    return 0
                fi
                oras attach --artifact-type "$2" "${reference}" "$1:$2" >/dev/null
                (( $3 )) || return 0
                prune_superseded "$2" "${reference}" "${ARTIFACT_DIR}/referrers.json"
            }
            attach_artifact "${runtime_id}-${arch}.spdx.json" application/spdx+json 0
            attach_artifact "${runtime_id}-${arch}.cdx.json" application/vnd.cyclonedx+json 0
            attach_artifact "${runtime_id}-${arch}.grype.json" "${GRYPE_TYPE}" "${refresh_dynamic}"
            attach_artifact "${runtime_id}-${arch}.provenance.json" "${PROVENANCE_TYPE}" "${refresh_dynamic}"
        )
    fi

    if [[ -n "${GITHUB_STEP_SUMMARY:-}" ]]; then
        {
            echo "#### Signed and attested: ${runtime_id} (${arch}) ${tag}"
            echo
            echo "- \`${reference}\`"
            if (( sign_only )); then
                echo "- signature only: the platform manifests carry the bundle"
            else
                echo "- SBOMs, CVE report and provenance attached to the digest"
            fi
            if (( refresh_dynamic )); then
                echo "- CVE report and provenance refreshed (superseded referrers pruned)"
            fi
            echo
        } >> "${GITHUB_STEP_SUMMARY}"
    fi
done
