#!/bin/bash
# Smoke-test a runtime's image.
#
# There is one image per runtime, on the Iron Bank UBI9 base, and two ways to
# prove it works — both under the STIG contract: the rootfs is mounted read-only,
# /tmp is the only writable path (a tmpfs owned by the runtime UID), and the
# process runs as that UID rather than as root.
#
# A runtime image is exercised through the Lambda Runtime Interface Emulator
# (RIE): the published image stays clean, RIE is bind-mounted read-only from the
# host cache at run time and overrides the entrypoint, exactly as AWS documents
# for container testing.
#
# A toolchain image has no handler to invoke, so it is exercised by the command
# its manifest declares (`container.smoke_test`): the toolchain itself, or the
# launcher's own handler contract. Skipping that check would ship an image nobody
# had ever executed.
#
#   local-invoke-container <runtime_id> <arch>
set -euo pipefail

source "$(dirname "$0")/_common.sh"

positional=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --ironbank) shift ;;  # no-op: every image is on the Iron Bank base
        -*) echo "Unknown option: $1" >&2; exit 2 ;;
        *) positional+=("$1"); shift ;;
    esac
done

runtime_id=$(common::require_runtime_id "${positional[0]:-}")
arch=$(common::require_arch "${positional[1]:-}")
common::load_runtime_env "${runtime_id}" "${arch}"

if [[ "${CONTAINER_ENABLED}" != "true" ]]; then
    echo "${runtime_id} (${arch}) has no container target (container.enabled=false)" >&2
    exit 1
fi

image="${CONTAINER_LOCAL_IMAGE}"
if ! docker image inspect "${image}" >/dev/null 2>&1; then
    bash "$(common::repo_root)/tools/bin/build-container" "${runtime_id}" "${arch}"
    common::load_runtime_env "${runtime_id}" "${arch}"
fi

# The STIG contract every invocation below asserts. `--tmpfs` owns /tmp by the
# runtime UID so the process can actually write there on a read-only rootfs.
stig_args=(
    --platform "${CONTAINER_PLATFORM}"
    --read-only
    --tmpfs /tmp:rw,exec,size=512m,uid=${CONTAINER_NONROOT_UID},gid=${CONTAINER_NONROOT_GID}
    --user "${CONTAINER_NONROOT_UID}:${CONTAINER_NONROOT_GID}"
)

# --- the manifest's own smoke test, for an image with no handler ---------------
if [[ "${CONTAINER_SMOKE_TEST}" != "{}" && -n "${CONTAINER_SMOKE_TEST}" ]]; then
    mapfile -t smoke < <(
        python3 - "${CONTAINER_SMOKE_TEST}" <<'PY'
import json
import sys

spec = json.loads(sys.argv[1] or "{}")
for arg in spec.get("argv") or []:
    print(arg)
PY
    )
    if (( ${#smoke[@]} == 0 )); then
        echo "${runtime_id} (${arch}) declares container.smoke_test with no argv" >&2
        exit 1
    fi
    expect_exit=$(python3 -c 'import json,sys; print(json.loads(sys.argv[1] or "{}").get("expect_exit", 0))' "${CONTAINER_SMOKE_TEST}")
    expect_output=$(python3 -c 'import json,sys; print(json.loads(sys.argv[1] or "{}").get("expect_output", ""))' "${CONTAINER_SMOKE_TEST}")
    expect_version=$(python3 -c 'import json,sys; print("yes" if json.loads(sys.argv[1] or "{}").get("expect_version") else "no")' "${CONTAINER_SMOKE_TEST}")

    echo "Running the declared smoke test in ${image} as ${CONTAINER_NONROOT_UID} on a read-only rootfs: ${smoke[*]}"
    set +e
    output=$(docker run --rm "${stig_args[@]}" \
        --workdir "${CONTAINER_WORKDIR}" \
        --entrypoint "${smoke[0]}" "${image}" "${smoke[@]:1}" 2>&1)
    status=$?
    set -e
    echo "${output}"

    if (( status != expect_exit )); then
        echo "${runtime_id} (${arch}): smoke test exited ${status}, expected ${expect_exit}" >&2
        exit 1
    fi
    if [[ -n "${expect_output}" ]] && ! grep -qF "${expect_output}" <<<"${output}"; then
        echo "${runtime_id} (${arch}): smoke test output did not carry '${expect_output}'" >&2
        exit 1
    fi
    if [[ "${expect_version}" == "yes" ]] && ! grep -qF "${DISTRIBUTION_VERSION}" <<<"${output}"; then
        echo "${runtime_id} (${arch}): the toolchain did not report version ${DISTRIBUTION_VERSION}" >&2
        exit 1
    fi
    echo "Container smoke test passed for ${runtime_id} (${arch})"
    exit 0
fi

skip=$(python3 - "${runtime_id}" "${arch}" <<'PY'
import sys

sys.path.insert(0, "tools/runtime_lib")
import runtime_manifest

data = runtime_manifest.load_runtime(sys.argv[1], arch=sys.argv[2])
print("true" if data.get("local_testing", {}).get("skip_local_invoke") else "false")
PY
)
if [[ "${skip}" == "true" ]]; then
    echo "${runtime_id} (${arch}) has no handler to invoke; skipping the RIE smoke test."
    exit 0
fi

rie="${DOWNLOADS_DIR}/aws-lambda-rie-${CONTAINER_ARCH}"
# Pinned like the other tools: a smoke test whose emulator changes under it is
# not comparable between runs. Override with AWS_LAMBDA_RIE_VERSION.
rie_version="${AWS_LAMBDA_RIE_VERSION:-v1.38}"
# The release assets are x86_64/arm64, not the OCI amd64/arm64 slug.
case "${CONTAINER_ARCH}" in
    amd64) rie_asset="aws-lambda-rie-x86_64" ;;
    arm64) rie_asset="aws-lambda-rie-arm64" ;;
    *) echo "No aws-lambda-rie asset for ${CONTAINER_ARCH}" >&2; exit 1 ;;
esac
if [[ ! -x "${rie}" ]]; then
    mkdir -p "${DOWNLOADS_DIR}"
    url="https://github.com/aws/aws-lambda-runtime-interface-emulator/releases/download/${rie_version}/${rie_asset}"
    echo "Downloading ${rie_asset} ${rie_version}"
    curl --fail --location --proto '=https' --tlsv1.2 \
        --retry 5 --retry-all-errors --retry-delay 2 --retry-connrefused \
        --connect-timeout 30 --output "${rie}" "${url}"
    chmod +x "${rie}"
fi

mapfile -t entrypoint < <(
    python3 - "${CONTAINER_ENTRYPOINT}" <<'PY'
import json
import sys

for arg in json.loads(sys.argv[1]):
    print(arg)
PY
)

port=$(python3 - <<'PY'
import socket

with socket.socket() as sock:
    sock.bind(("127.0.0.1", 0))
    print(sock.getsockname()[1])
PY
)

container="lrf-rie-${runtime_id}-${arch}-$$"
cleanup() {
    docker rm -f "${container}" >/dev/null 2>&1 || true
}
trap cleanup EXIT

# RIE is bind-mounted read-only from the host cache: the production image never
# carries the emulator, and the tmpfs is what the entrypoint's runtime may write.
echo "Starting ${image} under aws-lambda-rie on 127.0.0.1:${port} (user ${CONTAINER_NONROOT_UID}:${CONTAINER_NONROOT_GID}, read-only rootfs)"
docker run -d --rm --name "${container}" \
    "${stig_args[@]}" \
    -p "127.0.0.1:${port}:8080" \
    -v "${rie}:/tmp/aws-lambda-rie:ro" \
    -v "${LOCAL_CODE_URI}:/var/task:ro" \
    --entrypoint /tmp/aws-lambda-rie \
    -e "AWS_LAMBDA_FUNCTION_NAME=${LOCAL_FUNCTION_NAME}" \
    -e "AWS_LAMBDA_FUNCTION_VERSION=\$LATEST" \
    -e "AWS_LAMBDA_FUNCTION_MEMORY_SIZE=256" \
    -e "AWS_LAMBDA_LOG_GROUP_NAME=/aws/lambda/${runtime_id}" \
    -e "AWS_LAMBDA_LOG_STREAM_NAME=local" \
    -e "AWS_REGION=us-east-1" \
    -e "LAMBDA_TASK_ROOT=/var/task" \
    -e "_HANDLER=${LOCAL_HANDLER}" \
    "${image}" \
    "${entrypoint[@]}" >/dev/null

endpoint="http://127.0.0.1:${port}/2015-03-31/functions/function/invocations"
response=""
for _ in $(seq 1 60); do
    if response=$(curl -sS --max-time 5 -X POST "${endpoint}" \
        --data-binary "@${LOCAL_EVENT}" 2>/dev/null); then
        break
    fi
    if [[ "$(docker inspect -f '{{.State.Running}}' "${container}" 2>/dev/null)" != "true" ]]; then
        echo "Container exited before answering; logs:" >&2
        docker logs "${container}" >&2 || true
        exit 1
    fi
    sleep 1
done

echo "${response}"
if [[ -z "${response}" ]]; then
    echo "aws-lambda-rie never answered on ${endpoint}" >&2
    docker logs "${container}" >&2 || true
    exit 1
fi

failure=0
if ! grep -qE '"statusCode"[[:space:]]*:[[:space:]]*200' <<<"${response}"; then
    echo "container invocation returned no 200 response for ${runtime_id}" >&2
    failure=1
fi
if ! grep -q "hello world" <<<"${response}"; then
    echo "container invocation response did not carry the handler's payload for ${runtime_id}" >&2
    failure=1
fi

if (( failure )); then
    docker logs "${container}" >&2 || true
    exit 1
fi

echo "Container smoke test passed for ${runtime_id} (${arch})"
