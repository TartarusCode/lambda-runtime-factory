#!/bin/bash
# Generate the supply-chain bundle for one runtime's image.
#
# The image is the compliance artifact: its RPM database is what lets Syft produce
# a package-level SBOM with RHEL backport lineage, and it is what Grype resolves a
# CVE against. So the scan runs on the image, and the vulnerability report is
# produced *from the published SPDX document* rather than from a second, separate
# scan — an auditor can re-run `grype sbom:<file>` and get the same answer.
#
#   generate-compliance-artifacts <runtime_id> <arch> [--best-effort]
#
# The two SBOMs are cached under ${SBOM_CACHE_DIR} and verified by digest before
# reuse: the entry records the image digest, the base image digest and the Syft
# version, so a restored package list always describes the bytes being shipped. The
# vulnerability report and provenance are recomputed on every run — a cached CVE
# count would be wrong the moment Grype's database moves.
#
# The report is not filtered by policy: every fixable finding Grype resolves stays in
# it, and the severity gate is applied over that document against
# tools/compliance/ubi-lag-waivers.json. An advisory whose fixed RPM the base image
# cannot install yet is a time-boxed POA&M entry there, so the scan keeps naming the
# CVE while the build is allowed to ship.
#
# Writes into ${ARTIFACT_DIR}/compliance/:
#   <runtime>-<arch>.spdx.json        SPDX 2.3 JSON
#   <runtime>-<arch>.cdx.json         CycloneDX JSON
#   <runtime>-<arch>.grype.json       full vulnerability report
#   <runtime>-<arch>.grype.sarif      SARIF for GitHub Security / CodeQL
#   <runtime>-<arch>.provenance.json  hardening + provenance attestation
set -euo pipefail

source "$(dirname "$0")/_common.sh"

best_effort=0
positional=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --best-effort) best_effort=1; shift ;;
        -*) echo "Unknown option: $1" >&2; exit 2 ;;
        *) positional+=("$1"); shift ;;
    esac
done

runtime_id=$(common::require_runtime_id "${positional[0]:-}")
arch=$(common::require_arch "${positional[1]:-}")
common::load_runtime_env "${runtime_id}" "${arch}"

compliance_dir="${ARTIFACT_DIR}/compliance"
mkdir -p "${compliance_dir}"
stem="${compliance_dir}/${runtime_id}-${arch}"

missing_tool() {
    local message="Install $1 to produce the compliance bundle: $2"
    if (( best_effort )); then
        echo "${message}" >&2
        exit 0
    fi
    echo "${message}" >&2
    exit 1
}

type -P syft >/dev/null || missing_tool syft "https://github.com/anchore/syft#installation"
type -P grype >/dev/null || missing_tool grype "https://github.com/anchore/grype#installation"

if ! docker image inspect "${CONTAINER_LOCAL_IMAGE}" >/dev/null 2>&1; then
    bash "$(common::repo_root)/tools/bin/build-container" "${runtime_id}" "${arch}"
    common::load_runtime_env "${runtime_id}" "${arch}"
fi

# --- SBOMs ---------------------------------------------------------------------
# all-layers: the shipped filesystem is the union of every layer, and a base
# package removed in a later layer is still part of the story an auditor reads.
#
# A cache hit is a digest match, not a filename match. The metadata file under
# ${SBOM_CACHE_DIR} records the image digest, the base image digest and the Syft
# version that produced the documents, so an image rebuilt on different bytes
# never inherits another image's package list — the cache key only decides which
# candidate to *look* at. Both documents are restored together: they come from one
# Syft pass and must describe the same layer set.
cache_dir="${SBOM_CACHE_DIR}/${runtime_id}/${arch}"
cache_meta="${cache_dir}/sbom-cache-meta.json"
cached_spdx="${cache_dir}/${runtime_id}-${arch}.spdx.json"
cached_cdx="${cache_dir}/${runtime_id}-${arch}.cdx.json"

record_field() {  # record_field <key> [default]: one value from container.json
    python3 - "${ARTIFACT_DIR}/container.json" "$1" "${2:-}" <<'PY'
import json
import sys

path, key, default = sys.argv[1:4]
try:
    with open(path, encoding="utf-8") as handle:
        value = json.load(handle).get(key)
except Exception:
    value = None
print(value or default)
PY
}

image_digest=$(record_field image_digest)
base_image_digest=$(record_field base_image_digest "${CONTAINER_BASE_IMAGE_DIGEST:-}")
# Without container.json (a bare local run, before `build-container --finish`) the
# local image id is still the same content hash, so the cache stays honest.
if [[ -z "${image_digest}" ]]; then
    image_digest=$(docker image inspect --format '{{.Id}}' "${CONTAINER_LOCAL_IMAGE}" 2>/dev/null || true)
fi

# Syft's own version is part of the key: a new Syft can recognise packages the old
# one missed, so its output must never be served under an older entry.
syft_version=$(syft version -o json 2>/dev/null \
    | python3 -c 'import json, sys
try:
    print(json.load(sys.stdin).get("version", ""))
except Exception:
    print("")' || true)
if [[ -z "${syft_version}" ]]; then
    syft_version=$(syft --version 2>/dev/null | awk 'NF { print $NF; exit }')
fi

cache_state=$(python3 - "${cache_meta}" "${cached_spdx}" "${cached_cdx}" \
    "${image_digest}" "${base_image_digest}" "${syft_version}" <<'PY'
import json
import os
import sys

meta_path, spdx_path, cdx_path, image_digest, base_image_digest, syft_version = sys.argv[1:7]


def readable(path):
    return os.path.isfile(path) and os.path.getsize(path) > 0


try:
    with open(meta_path, encoding="utf-8") as handle:
        meta = json.load(handle)
except Exception:
    print("miss:no metadata at {}".format(meta_path))
    sys.exit(0)

if not image_digest:
    print("miss:no image digest to verify against")
elif meta.get("image_digest") != image_digest:
    print("miss:image digest {} -> {}".format(meta.get("image_digest"), image_digest))
elif meta.get("base_image_digest") != base_image_digest:
    print("miss:base digest {} -> {}".format(meta.get("base_image_digest"), base_image_digest))
elif meta.get("syft_version") != syft_version:
    print("miss:syft {} -> {}".format(meta.get("syft_version"), syft_version))
elif not readable(spdx_path) or not readable(cdx_path):
    print("miss:a cached document is missing or empty")
else:
    print("hit")
PY
)
cache_hit=${cache_state%%:*}
cache_reason=${cache_state#*:}

sbom_cache_hit=false
if [[ "${cache_hit}" == "hit" ]]; then
    cp "${cached_spdx}" "${stem}.spdx.json"
    cp "${cached_cdx}" "${stem}.cdx.json"
    sbom_cache_hit=true
    echo "SBOM cache hit for ${runtime_id} (${arch}) at ${image_digest}; restored ${cache_dir}"
else
    echo "Generating SBOMs for ${CONTAINER_LOCAL_IMAGE} (cache miss: ${cache_reason})"
    # One pass, both formats: `syft` unpacks every layer once. Two invocations
    # would unpack the same image twice for the same answer.
    syft "docker:${CONTAINER_LOCAL_IMAGE}" --scope all-layers -q \
        -o "spdx-json=${stem}.spdx.json" \
        -o "cyclonedx-json=${stem}.cdx.json"
fi

# --- the SBOM must describe the image we ship ----------------------------------
# An SBOM with only the payload, or only the base, describes a machine that is not
# this image: the first hides the OS CVEs, the second hides the runtime. It runs on
# every path — a restored entry is verified exactly like a fresh one, because the
# cache is an optimisation, not a claim.
python3 - "${stem}.spdx.json" "${runtime_id}" "${stem}.sbom-stats.json" \
    "${stem}.cdx.json" <<'PYEOF'
import json
import sys

sbom_path, runtime_id, stats_path = sys.argv[1:4]
cdx_path = sys.argv[4] if len(sys.argv) > 4 else ""
doc = json.load(open(sbom_path, encoding="utf-8"))
packages = doc.get("packages") or []

if not packages:
    sys.exit(f"{sbom_path}: the SBOM has no packages at all")

def purls(package):
    return [
        ref.get("referenceLocator", "")
        for ref in (package.get("externalRefs") or [])
        if str(ref.get("referenceType", "")).lower() == "purl"
    ]

rpm_packages = [p for p in packages if any(loc.startswith("pkg:rpm/") for loc in purls(p))]
runtime_packages = [p for p in packages if p not in rpm_packages]

# The base must be visible by name: without it the SBOM describes only the
# payload, so every OS CVE would be missing from the report.
base_names = ("glibc", "zlib", "openssl-libs", "ca-certificates")
seen = {name: False for name in base_names}
for package in packages:
    label = (package.get("name") or "").lower()
    for wanted in base_names:
        if label == wanted or label.startswith(wanted + "-"):
            seen[wanted] = True
missing = [name for name, found in seen.items() if not found]
if missing:
    sys.exit(
        f"{sbom_path}: no UBI9 base packages ({', '.join(missing)}) — the RPM database "
        "did not reach Syft, so this SBOM cannot carry RHEL backport lineage"
    )

if not runtime_packages:
    sys.exit(f"{sbom_path}: no runtime packages — the SBOM describes the base but not /opt")

# The CycloneDX document travels with the SPDX one, so it carries the same claim:
# an empty component list would attach an SBOM that attests to nothing.
if cdx_path:
    components = (json.load(open(cdx_path, encoding="utf-8")).get("components") or [])
    if not components:
        sys.exit(f"{cdx_path}: the CycloneDX document has no components")

with open(stats_path, "w", encoding="utf-8") as handle:
    json.dump(
        {"total": len(packages), "rpm": len(rpm_packages), "runtime": len(runtime_packages)},
        handle,
        indent=2,
        sort_keys=True,
    )
    handle.write("\n")
print(f"SBOM: {len(packages)} packages ({len(rpm_packages)} rpm, {len(runtime_packages)} runtime), base present")
PYEOF

# --- cache the documents, but only after the assertion accepted them ------------
if [[ "${sbom_cache_hit}" != "true" ]]; then
    mkdir -p "${cache_dir}"
    cp "${stem}.spdx.json" "${cached_spdx}"
    cp "${stem}.cdx.json" "${cached_cdx}"
    python3 - "${cache_meta}" "${runtime_id}" "${arch}" "${image_digest}" \
        "${base_image_digest}" "${syft_version}" "${stem}.sbom-stats.json" <<'PY'
import json
import sys

path, runtime_id, arch, image_digest, base_image_digest, syft_version, stats = sys.argv[1:8]

record = {
    "runtime_id": runtime_id,
    "arch": arch,
    "image_digest": image_digest,
    "base_image_digest": base_image_digest,
    "syft_version": syft_version,
}
try:
    with open(stats, encoding="utf-8") as handle:
        record["packages"] = json.load(handle)
except Exception:
    pass

with open(path, "w", encoding="utf-8") as handle:
    json.dump(record, handle, indent=2, sort_keys=True)
    handle.write("\n")
print(f"Cached SBOMs for {runtime_id} ({arch}) at {path}")
PY
fi

# --- vulnerability report, produced from the SPDX we publish --------------------
grype_config_args=()
if [[ -f "${RUNTIME_DIR}/.grype.yaml" ]]; then
    grype_config_args=(-c "${RUNTIME_DIR}/.grype.yaml")
fi

echo "Scanning ${stem}.spdx.json with Grype"
set +e
# `--fail-on` is deliberately absent: the severity decision belongs to the gate
# below, which reads this report and applies the UBI-lag POA&M. `--only-fixed` stays,
# so the report and the counts derived from it describe the findings an operator can
# actually act on — the policy this pipeline has always published.
grype "${grype_config_args[@]}" "sbom:${stem}.spdx.json" \
    -o "json=${stem}.grype.json" \
    -o "sarif=${stem}.grype.sarif" --only-fixed -q
grype_status=$?
set -e

if (( grype_status != 0 )); then
    echo "${runtime_id} (${arch}): Grype exited ${grype_status}; a report it may have written is not trusted" >&2
    exit "${grype_status}"
fi

# --- the severity gate ---------------------------------------------------------
# A fixable High or Critical finding fails the cell unless an active entry in the
# UBI-lag POA&M file names that exact CVE, package and installed build. Keeping the
# acknowledgement outside Grype is what lets the report stay complete; keeping it in
# a separate file with an expiry is what stops it becoming permanent. An entry stops
# covering anything on its expiry date, and once the installed package reaches the
# fixed build the entry is reported for removal instead of quietly outliving the lag.
waiver_file="${UBI_LAG_WAIVERS:-$(common::repo_root)/tools/compliance/ubi-lag-waivers.json}"
gate_file="${stem}.grype-gate.json"
set +e
python3 - "${stem}.grype.json" "${waiver_file}" "${gate_file}" "${stem}.spdx.json" \
    "${UBI_LAG_WAIVER_TODAY:-}" "${runtime_id}" "${arch}" "$(common::repo_root)" <<'PYEOF'
import json
import os
import sys
from datetime import date

report_path, waivers_path, gate_path = sys.argv[1:4]
spdx_path = sys.argv[4] if len(sys.argv) > 4 else ""
day_arg = sys.argv[5] if len(sys.argv) > 5 else ""
runtime_id = sys.argv[6] if len(sys.argv) > 6 else ""
arch = sys.argv[7] if len(sys.argv) > 7 else ""
repo_root = sys.argv[8] if len(sys.argv) > 8 else ""

SEVERITIES = ("critical", "high")
REQUIRED = ("advisory", "package", "installed_evr", "fixed_evr", "expires_on", "reason", "cves")
# Waiver states the gate refuses to pass: the acknowledgement no longer describes a
# live lag, so leaving it in the tree would keep releasing a finding nobody is
# tracking. "expired" is different — it releases nothing and the findings block on
# their own — and "absent" is a record for a package this image does not carry.
STALE_STATES = ("resolved", "mismatched")


def label(text):
    return f"{runtime_id} ({arch}): {text}" if runtime_id else text


# One implementation of RPM ordering for the whole pipeline: the weekly retainer
# retires an entry with the same comparison the gate uses to call one stale.
if repo_root:
    sys.path.insert(0, os.path.join(repo_root, "tools", "runtime_lib"))
try:
    from ubi_repo import is_at_least, normalize_evr
except ImportError as error:
    print(
        f"::error::cannot load tools/runtime_lib/ubi_repo.py from {repo_root or 'the checkout'}: {error}",
        file=sys.stderr,
    )
    sys.exit(2)


def fail(text):
    # Exit 2 for a policy failure: the same code Grype uses for "found something",
    # so a caller keying on the status cannot mistake it for success.
    message = label(text)
    print(f"::error::{message}" if runtime_id else message, file=sys.stderr)
    sys.exit(2)


def load(path, what):
    try:
        with open(path, encoding="utf-8") as handle:
            return json.load(handle)
    except OSError as error:
        fail(f"{what}: {error}")
    except ValueError as error:
        fail(f"{what} is not valid JSON: {error}")


def evr(value):
    """`0:1.21.1-10.el9_8.1`, `1.21.1-10.el9_8.1` and `1.21.1-10.el9_8.1.x86_64`
    name one build, so the epoch and the arch suffix cannot decide a match."""
    return normalize_evr(value)


def installed_versions(package):
    """What the image actually carries, read from the SBOM the report came from —
    a match only exists for a package that has a finding, so an upgraded (now clean)
    package would be invisible here."""
    if not spdx_path:
        return set()
    try:
        with open(spdx_path, encoding="utf-8") as handle:
            document = json.load(handle)
    except (OSError, ValueError):
        return set()
    wanted = package.lower()
    return {
        evr(entry.get("versionInfo"))
        for entry in (document.get("packages") or [])
        if str(entry.get("name") or "").lower() == wanted
    }


raw = load(waivers_path, f"the UBI-lag POA&M file {waivers_path}")
entries = raw.get("waivers") if isinstance(raw, dict) else None
# An empty list is the end state, not a broken file: the weekly update run removes
# the last entry the week the fixed RPM lands, and the file stays as the record of
# where acknowledgements go.
if not isinstance(entries, list):
    fail(f"{waivers_path} has no 'waivers' list")

waivers = []
for index, entry in enumerate(entries):
    where = f"{waivers_path} waiver #{index + 1}"
    missing = [key for key in REQUIRED if not entry.get(key)]
    if missing:
        fail(f"{where} is missing {', '.join(missing)}")
    cves = entry.get("cves")
    if not isinstance(cves, list) or not cves:
        fail(f"{where} lists no CVEs")
    try:
        expires = date.fromisoformat(str(entry["expires_on"]))
    except ValueError:
        fail(f"{where} has expires_on={entry['expires_on']!r}, which is not YYYY-MM-DD")
    waivers.append(
        {
            "advisory": str(entry["advisory"]),
            "package": str(entry["package"]),
            "installed_evr": evr(entry["installed_evr"]),
            "fixed_evr": evr(entry["fixed_evr"]),
            "expires_on": expires,
            "cves": {str(cve).upper() for cve in cves},
        }
    )

report = load(report_path, f"the Grype report {report_path}")
today = date.fromisoformat(day_arg) if day_arg else date.today()

poam = []
for waiver in waivers:
    versions = installed_versions(waiver["package"])
    if not versions:
        state = "absent"
        detail = "the image carries no package by that name"
    elif waiver["installed_evr"] in versions:
        state = "active"
        detail = f"the image carries the waived build {waiver['installed_evr']}"
    elif any(is_at_least(version, waiver["fixed_evr"]) for version in versions):
        state = "resolved"
        detail = (
            f"the image carries {', '.join(sorted(versions))}, at or past the fixed build "
            f"{waiver['fixed_evr']}, so the lag window has closed and the entry is dead"
        )
    else:
        state = "mismatched"
        detail = (
            f"the image carries {', '.join(sorted(versions))}, which is neither the waived "
            f"build {waiver['installed_evr']} nor the fixed one {waiver['fixed_evr']}"
        )
    if waiver["expires_on"] < today:
        state = "expired"
        detail = f"expired on {waiver['expires_on'].isoformat()}; {detail}"
    poam.append(
        {
            "advisory": waiver["advisory"],
            "package": waiver["package"],
            "state": state,
            "expires_on": waiver["expires_on"].isoformat(),
            "detail": detail,
            "installed_versions": sorted(versions),
            "cves": sorted(waiver["cves"]),
        }
    )

blocking = []
waived = []
for match in report.get("matches") or []:
    vulnerability = match.get("vulnerability") or {}
    severity = str(vulnerability.get("severity") or "").lower()
    if severity not in SEVERITIES:
        continue
    fix = vulnerability.get("fix") or {}
    fixed_versions = [evr(version) for version in (fix.get("versions") or [])]
    if str(fix.get("state") or "").lower() != "fixed" or not fixed_versions:
        continue
    artifact = match.get("artifact") or {}
    package = str(artifact.get("name") or "")
    installed_version = evr(artifact.get("version"))
    cve = str(vulnerability.get("id") or "").upper()
    covering = next(
        (
            waiver
            for waiver in waivers
            if waiver["package"].lower() == package.lower()
            and cve in waiver["cves"]
            and waiver["installed_evr"] == installed_version
            and waiver["fixed_evr"] in fixed_versions
            and waiver["expires_on"] >= today
        ),
        None,
    )
    record = {
        "cve": cve,
        "package": package,
        "installed_version": installed_version,
        "fixed_version": fixed_versions[0],
        "severity": severity,
    }
    if covering is None:
        blocking.append(record)
    else:
        waived.append(
            {
                **record,
                "advisory": covering["advisory"],
                "expires_on": covering["expires_on"].isoformat(),
            }
        )

# A stale entry fails the run on its own, whether or not a finding depends on it:
# "resolved" means the image already carries the fix, so the acknowledgement is dead
# and the gate would otherwise keep releasing a package nobody needs released;
# "mismatched" means the entry names a build the image does not carry, so the record
# an auditor reads is wrong. "absent" is a notice — the image does not carry the
# package at all — and "expired" releases nothing, so its findings block by
# themselves rather than through this check.
result = "fail" if blocking or any(entry["state"] in STALE_STATES for entry in poam) else "pass"

gate = {
    "runtime_id": runtime_id,
    "arch": arch,
    "today": today.isoformat(),
    "result": result,
    "policy": (
        "fixable High and Critical findings fail unless an active, unexpired UBI-lag "
        "POA&M entry names that CVE, package and installed build"
    ),
    "blocking": blocking,
    "waived": waived,
    "waived_high": sum(1 for item in waived if item["severity"] == "high"),
    "waived_critical": sum(1 for item in waived if item["severity"] == "critical"),
    "active_advisories": sorted({item["advisory"] for item in waived}),
    "poam": poam,
}
with open(gate_path, "w", encoding="utf-8") as handle:
    json.dump(gate, handle, indent=2, sort_keys=True)
    handle.write("\n")

for record in blocking:
    print(
        label(
            f"  blocking {record['cve']} {record['package']} "
            f"{record['installed_version']} -> {record['fixed_version']}"
        ),
        file=sys.stderr,
    )
for record in waived:
    print(
        label(
            f"  waived {record['cve']} {record['package']} {record['installed_version']} "
            f"-> {record['fixed_version']} [{record['advisory']}]"
        ),
        file=sys.stderr,
    )
for entry in poam:
    if entry["state"] == "active":
        print(
            label(
                f"POA&M {entry['advisory']}: {entry['package']} {entry['installed_versions']} "
                f"waived until {entry['expires_on']} ({len(entry['cves'])} CVE(s))"
            ),
            file=sys.stderr,
        )
    else:
        message = label(
            f"POA&M {entry['advisory']} for {entry['package']} is {entry['state']}: "
            f"{entry['detail']} — remove it from tools/compliance/ubi-lag-waivers.json"
        )
        # A stale entry is an error, not a warning: it fails this run, and the
        # annotation is what a reader sees in the step log before the exit code.
        level = "error" if entry["state"] in STALE_STATES else "warning"
        print(f"::{level}::{message}" if runtime_id else message, file=sys.stderr)

summary = (
    f"{len(blocking)} unwaived fixable High/Critical CVE(s), "
    f"{len(waived)} waived ({gate['waived_high']} High, {gate['waived_critical']} Critical)"
)
if result == "fail":
    print(f"::error::{label('the severity gate failed: ' + summary)}" if runtime_id else label(
        f"the severity gate failed: {summary}"
    ), file=sys.stderr)
    sys.exit(2)
print(label(f"the severity gate passed: {summary}"), file=sys.stderr)
PYEOF
gate_status=$?
set -e
if (( gate_status != 0 )) && (( best_effort )); then
    echo "  (best effort: the gate verdict was recorded, not enforced)" >&2
    gate_status=0
fi

# --- provenance ----------------------------------------------------------------
payload_manifest="${LAYER_ROOT}/runtime-manifest.json"
if [[ ! -f "${payload_manifest}" ]]; then
    echo "Missing ${payload_manifest}: rebuild the payload so the image records where it came from" >&2
    exit 1
fi

python3 - "${stem}" "${payload_manifest}" "${ARTIFACT_DIR}" "${CONTAINER_LOCAL_IMAGE}" \
    "${sbom_cache_hit}" "${gate_file}" <<'PYEOF'
import hashlib
import json
import os
import subprocess
import sys

stem, payload_manifest, artifact_dir, image = sys.argv[1:5]
# Absent when the block is run on its own (the tests do that): a document without
# the flag describes a fresh scan, which is what the default means.
sbom_cache_hit = (sys.argv[5] if len(sys.argv) > 5 else "false").strip().lower() == "true"
# Likewise absent on its own: without a gate verdict there is nothing to record.
gate_path = sys.argv[6] if len(sys.argv) > 6 else ""

def load(path):
    with open(path, encoding="utf-8") as handle:
        return json.load(handle)

def sha256(path):
    digest = hashlib.sha256()
    with open(path, "rb") as handle:
        for block in iter(lambda: handle.read(1 << 20), b""):
            digest.update(block)
    return digest.hexdigest()

def docker_format(template, ref):
    try:
        return subprocess.run(
            ["docker", "image", "inspect", "--format", template, ref],
            capture_output=True, text=True, check=True,
        ).stdout.strip()
    except subprocess.CalledProcessError:
        return ""

payload = load(payload_manifest)
container_record = {}
record_path = os.path.join(artifact_dir, "container.json")
if os.path.exists(record_path):
    container_record = load(record_path)

grype_path = stem + ".grype.json"
counts = {"Critical": 0, "High": 0, "Medium": 0, "Low": 0, "Negligible": 0, "Unknown": 0}
if os.path.exists(grype_path):
    for match in (load(grype_path).get("matches") or []):
        severity = ((match.get("vulnerability") or {}).get("severity") or "Unknown").capitalize()
        counts[severity if severity in counts else "Unknown"] += 1

provenance = {
    "runtime_id": payload.get("runtime_id"),
    "arch": payload.get("arch"),
    "distribution_version": payload.get("distribution_version"),
    "upstream_archive_url": payload.get("upstream_archive_url"),
    "upstream_sha256": payload.get("upstream_sha256"),
    "base_image_ref": container_record.get("base_image_ref", ""),
    "base_image_digest": container_record.get("base_image_digest", ""),
    "image_digest": docker_format("{{.Id}}", image),
    "unpacked_size_bytes": container_record.get("unpacked_size_bytes", container_record.get("unpacked_bytes", 0)),
    "stig_verification": {
        "user": container_record.get("user", ""),
        "package_managers_removed": container_record.get("package_managers_removed", False),
        "rpm_db_present": container_record.get("rpm_db_present", False),
        "read_only_rootfs_verified": container_record.get("read_only_rootfs_verified", False),
    },
    "sbom": {
        "packages": load(stem + ".sbom-stats.json") if os.path.exists(stem + ".sbom-stats.json") else {},
    },
    "sbom_sha256": {
        "spdx": sha256(stem + ".spdx.json") if os.path.exists(stem + ".spdx.json") else "",
        "cdx": sha256(stem + ".cdx.json") if os.path.exists(stem + ".cdx.json") else "",
    },
    # Recorded, not inferred: an auditor reading the release can tell whether the
    # package list was regenerated for these bytes or restored from the cache, and
    # the two documents' hashes above prove the restored bytes are the same ones.
    "sbom_cache_hit": sbom_cache_hit,
    "grype_summary": counts,
}

# The gate verdict and the POA&M it applied, recorded beside the raw counts: the
# summary above stays raw, because a waived finding is still a finding and an
# artifact that reported high=0 would misdescribe the image. These keys say how
# many findings the severity gate let through, under which advisory, and until when.
gate = {}
if gate_path and os.path.exists(gate_path):
    gate = load(gate_path)
if gate:
    provenance.update(
        {
            "cve_gate": gate.get("result", ""),
            "ubi_lag_waived_high": gate.get("waived_high", 0),
            "ubi_lag_waived_critical": gate.get("waived_critical", 0),
            "waived_cve_ids": sorted(
                item.get("cve", "") for item in (gate.get("waived") or [])
            ),
            "unwaived_blocking_cves": len(gate.get("blocking") or []),
            "unwaived_blocking_cve_ids": sorted(
                item.get("cve", "") for item in (gate.get("blocking") or [])
            ),
            "active_poam_advisories": gate.get("active_advisories") or [],
        }
    )

out = stem + ".provenance.json"
with open(out, "w", encoding="utf-8") as handle:
    json.dump(provenance, handle, indent=2, sort_keys=True)
    handle.write("\n")
print(f"Provenance: {out}")
print(f"CVEs: critical={counts['Critical']} high={counts['High']} medium={counts['Medium']} low={counts['Low']}")
PYEOF

if [[ -n "${GITHUB_STEP_SUMMARY:-}" ]]; then
    python3 - "${stem}.provenance.json" "${GITHUB_STEP_SUMMARY}" <<'PYEOF'
import json
import sys

provenance = json.load(open(sys.argv[1], encoding="utf-8"))
counts = provenance["grype_summary"]
base = "IronBank" if "registry1.dso.mil" in provenance["base_image_ref"] else "UBI-Fallback"
with open(sys.argv[2], "a", encoding="utf-8") as handle:
    handle.write(
        "| {runtime_id} | {arch} | {base} | {size:.1f} | {sbom} | {c}/{h}/{m}/{l} |\n".format(
            runtime_id=provenance["runtime_id"],
            arch=provenance["arch"],
            base=base,
            size=(provenance["unpacked_size_bytes"] or 0) / 1048576,
            sbom="spdx+cdx",
            c=counts["Critical"], h=counts["High"], m=counts["Medium"], l=counts["Low"],
        )
    )
PYEOF
fi

echo "Compliance bundle for ${runtime_id} (${arch}) written to ${compliance_dir}"
# The bundle is written before the verdict is returned: a cell that fails the gate
# still publishes the report, the SARIF and the provenance an auditor needs, and the
# step's red status is what carries the failure.
exit "${gate_status}"
