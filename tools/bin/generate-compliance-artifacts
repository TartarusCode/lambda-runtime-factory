#!/bin/bash
# Generate the supply-chain bundle for one runtime's image.
#
# The image is the compliance artifact: its RPM database is what lets Syft produce
# a package-level SBOM with RHEL backport lineage, and it is what Grype resolves a
# CVE against. So the scan runs on the image, and the vulnerability report is
# produced *from the published SPDX document* rather than from a second, separate
# scan — an auditor can re-run `grype sbom:<file>` and get the same answer.
#
#   generate-compliance-artifacts <runtime_id> <arch> [--best-effort]
#
# One Syft pass produces both SBOM formats; the vulnerability report and provenance
# are recomputed on every run, because a cached CVE count would be wrong the moment
# Grype's database moves.
#
# The report is not filtered by policy: every fixable finding Grype resolves stays in
# it, and the severity gate is applied over that document against
# tools/compliance/ubi-lag-waivers.json. An advisory whose fixed RPM the base image
# cannot install yet is a time-boxed POA&M entry there, so the scan keeps naming the
# CVE while the build is allowed to ship.
#
# Enforcement follows the base. An image built from registry1.dso.mil is the release
# artifact and its verdict is enforced; a build from the Red Hat fallback (a fork PR
# or a local run without IRONBANK_TOKEN) writes the same bundle and logs the same
# counts, but records the verdict as advisory and exits 0. The fallback never
# publishes, so an unenforced scan cannot reach a consumer.
#
# This script orchestrates the tools; the gate, the SBOM assertion and the
# provenance document live in tools/runtime_lib/compliance.py.
#
# Writes into ${ARTIFACT_DIR}/compliance/:
#   <runtime>-<arch>.spdx.json        SPDX 2.3 JSON
#   <runtime>-<arch>.cdx.json         CycloneDX JSON
#   <runtime>-<arch>.grype.json       full vulnerability report
#   <runtime>-<arch>.grype.sarif      SARIF for GitHub Security / CodeQL
#   <runtime>-<arch>.provenance.json  hardening + provenance attestation
set -euo pipefail

source "$(dirname "$0")/_common.sh"

best_effort=0
positional=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --best-effort) best_effort=1; shift ;;
        -*) echo "Unknown option: $1" >&2; exit 2 ;;
        *) positional+=("$1"); shift ;;
    esac
done

runtime_id=$(common::require_runtime_id "${positional[0]:-}")
arch=$(common::require_arch "${positional[1]:-}")
common::load_runtime_env "${runtime_id}" "${arch}"

compliance_dir="${ARTIFACT_DIR}/compliance"
mkdir -p "${compliance_dir}"
stem="${compliance_dir}/${runtime_id}-${arch}"
compliance_cli="$(common::repo_root)/tools/runtime_lib/compliance.py"

missing_tool() {
    local message="Install $1 to produce the compliance bundle: $2"
    if (( best_effort )); then
        echo "${message}" >&2
        exit 0
    fi
    echo "${message}" >&2
    exit 1
}

type -P syft >/dev/null || missing_tool syft "https://github.com/anchore/syft#installation"
type -P grype >/dev/null || missing_tool grype "https://github.com/anchore/grype#installation"

if ! docker image inspect "${CONTAINER_LOCAL_IMAGE}" >/dev/null 2>&1; then
    bash "$(common::repo_root)/tools/bin/build-container" "${runtime_id}" "${arch}"
    common::load_runtime_env "${runtime_id}" "${arch}"
fi

record_field() {  # record_field <key> [default]: one value from container.json
    python3 - "${ARTIFACT_DIR}/container.json" "$1" "${2:-}" <<'PY'
import json
import sys

path, key, default = sys.argv[1:4]
try:
    with open(path, encoding="utf-8") as handle:
        value = json.load(handle).get(key)
except Exception:
    value = None
print(value or default)
PY
}

base_image_ref=$(record_field base_image_ref)
# Only an image built on registry1.dso.mil is a compliance-enforced artifact. A
# build from the Red Hat fallback (a fork PR or a local run without IRONBANK_TOKEN)
# still runs the scan and writes the bundle, but its verdict is recorded as
# advisory: the fallback exists so unauthenticated builds can be exercised, and it
# never publishes a release. `--best-effort` asks for the same treatment locally.
base_source="ironbank"
if [[ -n "${base_image_ref}" && "${base_image_ref}" != registry1.dso.mil/* ]]; then
    base_source="fallback"
fi
enforcement="enforced"
if [[ "${base_source}" == "fallback" ]] || (( best_effort )); then
    enforcement="advisory"
fi

# --- SBOMs ---------------------------------------------------------------------
# all-layers: the shipped filesystem is the union of every layer, and a base
# package removed in a later layer is still part of the story an auditor reads.
echo "Generating SBOMs for ${CONTAINER_LOCAL_IMAGE}"
syft "docker:${CONTAINER_LOCAL_IMAGE}" --scope all-layers -q \
    -o "spdx-json=${stem}.spdx.json" \
    -o "cyclonedx-json=${stem}.cdx.json"

python3 "${compliance_cli}" sbom-check \
    --spdx "${stem}.spdx.json" \
    --runtime "${runtime_id}" \
    --stats "${stem}.sbom-stats.json" \
    --cdx "${stem}.cdx.json"

# --- vulnerability report, produced from the SPDX we publish --------------------
grype_config_args=()
if [[ -f "${RUNTIME_DIR}/.grype.yaml" ]]; then
    grype_config_args=(-c "${RUNTIME_DIR}/.grype.yaml")
fi

echo "Scanning ${stem}.spdx.json with Grype"
set +e
# `--fail-on` is deliberately absent: the severity decision belongs to the gate
# below, which reads this report and applies the UBI-lag POA&M. `--only-fixed` stays,
# so the report and the counts derived from it describe the findings an operator can
# actually act on.
grype "${grype_config_args[@]}" "sbom:${stem}.spdx.json" \
    -o "json=${stem}.grype.json" \
    -o "sarif=${stem}.grype.sarif" --only-fixed -q
grype_status=$?
set -e

if (( grype_status != 0 )); then
    echo "${runtime_id} (${arch}): Grype exited ${grype_status}; a report it may have written is not trusted" >&2
    exit "${grype_status}"
fi

# --- the severity gate ---------------------------------------------------------
# A fixable High or Critical finding fails an Iron Bank cell unless an active entry
# in the UBI-lag POA&M file names that CVE and package. Keeping the acknowledgement
# outside Grype is what lets the report stay complete; keeping it in a separate file
# with an expiry is what stops it becoming permanent. Retirement is the weekly
# prune-waivers run's job, so a stale entry is reported rather than enforced.
waiver_file="${UBI_LAG_WAIVERS:-$(common::repo_root)/tools/compliance/ubi-lag-waivers.json}"
gate_file="${stem}.grype-gate.json"
set +e
python3 "${compliance_cli}" gate \
    --report "${stem}.grype.json" \
    --waivers "${waiver_file}" \
    --gate-out "${gate_file}" \
    --spdx "${stem}.spdx.json" \
    --today "${UBI_LAG_WAIVER_TODAY:-}" \
    --runtime "${runtime_id}" \
    --arch "${arch}" \
    --enforcement "${enforcement}" \
    --base-source "${base_source}"
gate_status=$?
set -e
if (( gate_status != 0 )) && (( best_effort )); then
    echo "  (best effort: the gate verdict was recorded, not enforced)" >&2
    gate_status=0
fi

# --- digest lineage -------------------------------------------------------------
# The provenance attestation is what an auditor reads after the tag has moved, so the
# digest this build replaces is resolved *before* push-container overwrites the tag.
# A registry this job cannot read — an audit run does not log in — answers nothing, and
# the provenance records null rather than a guess: "no previous image" and "could not
# ask" must not look the same in an attestation.
mapfile -t lineage_registries < <(python3 -c 'import json,sys
for registry in json.loads(sys.argv[1]): print(registry)' "${CONTAINER_REGISTRIES_OVERRIDE:-${CONTAINER_REGISTRIES:-[]}}")
for registry in "${lineage_registries[@]}"; do
    reference="${registry}/${RUNTIME_ID}:${CONTAINER_TAG}-${CONTAINER_ARCH}"
    superseded=$(common::superseded_digest "${CONTAINER_LOCAL_IMAGE}" "${reference}")
    if [[ -n "${superseded}" ]]; then
        common::record_supersedes "${registry}" "${reference}" "${superseded}"
        echo "${runtime_id} (${arch}): ${superseded} on ${registry} becomes untagged when this build is published"
    fi
done

# --- provenance ----------------------------------------------------------------
payload_manifest="${PAYLOAD_ROOT}/runtime-manifest.json"
if [[ ! -f "${payload_manifest}" ]]; then
    echo "Missing ${payload_manifest}: rebuild the payload so the image records where it came from" >&2
    exit 1
fi

python3 "${compliance_cli}" provenance \
    --stem "${stem}" \
    --payload-manifest "${payload_manifest}" \
    --artifact-dir "${ARTIFACT_DIR}" \
    --image "${CONTAINER_LOCAL_IMAGE}" \
    --gate "${gate_file}"

if [[ -n "${GITHUB_STEP_SUMMARY:-}" ]]; then
    python3 "${compliance_cli}" summary \
        --provenance "${stem}.provenance.json" \
        --summary "${GITHUB_STEP_SUMMARY}"
fi

echo "Compliance bundle for ${runtime_id} (${arch}) written to ${compliance_dir}"
# The bundle is written before the verdict is returned: a cell that fails the gate
# still publishes the report, the SARIF and the provenance an auditor needs, and the
# step's red status is what carries the failure.
exit "${gate_status}"
