#!/bin/bash
# Generate the supply-chain bundle for one runtime's image.
#
# The image is the compliance artifact: its RPM database is what lets Syft produce
# a package-level SBOM with RHEL backport lineage, and it is what Grype resolves a
# CVE against. So the scan runs on the image, and the vulnerability report is
# produced *from the published SPDX document* rather than from a second, separate
# scan — an auditor can re-run `grype sbom:<file>` and get the same answer.
#
#   generate-compliance-artifacts <runtime_id> <arch> [--best-effort]
#
# Writes into ${ARTIFACT_DIR}/compliance/:
#   <runtime>-<arch>.spdx.json        SPDX 2.3 JSON
#   <runtime>-<arch>.cdx.json         CycloneDX JSON
#   <runtime>-<arch>.grype.json       full vulnerability report
#   <runtime>-<arch>.grype.sarif      SARIF for GitHub Security / CodeQL
#   <runtime>-<arch>.provenance.json  hardening + provenance attestation
set -euo pipefail

source "$(dirname "$0")/_common.sh"

best_effort=0
positional=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --best-effort) best_effort=1; shift ;;
        -*) echo "Unknown option: $1" >&2; exit 2 ;;
        *) positional+=("$1"); shift ;;
    esac
done

runtime_id=$(common::require_runtime_id "${positional[0]:-}")
arch=$(common::require_arch "${positional[1]:-}")
common::load_runtime_env "${runtime_id}" "${arch}"

compliance_dir="${ARTIFACT_DIR}/compliance"
mkdir -p "${compliance_dir}"
stem="${compliance_dir}/${runtime_id}-${arch}"

missing_tool() {
    local message="Install $1 to produce the compliance bundle: $2"
    if (( best_effort )); then
        echo "${message}" >&2
        exit 0
    fi
    echo "${message}" >&2
    exit 1
}

type -P syft >/dev/null || missing_tool syft "https://github.com/anchore/syft#installation"
type -P grype >/dev/null || missing_tool grype "https://github.com/anchore/grype#installation"

if ! docker image inspect "${CONTAINER_LOCAL_IMAGE}" >/dev/null 2>&1; then
    bash "$(common::repo_root)/tools/bin/build-container" "${runtime_id}" "${arch}"
    common::load_runtime_env "${runtime_id}" "${arch}"
fi

# --- SBOMs ---------------------------------------------------------------------
# all-layers: the shipped filesystem is the union of every layer, and a base
# package removed in a later layer is still part of the story an auditor reads.
echo "Generating SBOMs for ${CONTAINER_LOCAL_IMAGE}"
syft "docker:${CONTAINER_LOCAL_IMAGE}" --scope all-layers -q \
    -o "spdx-json=${stem}.spdx.json" \
    -o "cyclonedx-json=${stem}.cdx.json"

# --- the SBOM must describe the image we ship ----------------------------------
# An SBOM with only the payload, or only the base, describes a machine that is not
# this image: the first hides the OS CVEs, the second hides the runtime.
python3 - "${stem}.spdx.json" "${runtime_id}" <<'PYEOF'
import json
import sys

path, runtime_id = sys.argv[1:3]
doc = json.load(open(path, encoding="utf-8"))
packages = doc.get("packages") or []

def named(package):
    return (package.get("name") or "").lower()

rpmish = [
    package for package in packages
    if any("rpm" in str(value).lower() for value in (package.get("externalRefs") or [{}])[0].values())
]
base_hits = {name: False for name in ("glibc", "zlib", "openssl-libs", "ca-certificates")}
for package in packages:
    name = named(package)
    for wanted in base_hits:
        if name == wanted or name.startswith(wanted + "-"):
            base_hits[wanted] = True
payload_hits = [
    package for package in packages
    if any("opt/" in str(location) for location in (package.get("sourceInfo") or "").split())
    or any("opt/" in str(location) for location in (package.get("downloadLocation") or "").split())
]

if not packages:
    sys.exit(f"{path}: the SBOM has no packages at all")
missing = [name for name, found in base_hits.items() if not found]
if missing:
    sys.exit(
        f"{path}: no UBI9 base packages ({', '.join(missing)}) — the RPM database did "
        "not reach Syft, so this SBOM cannot carry RHEL backport lineage"
    )
print(f"SBOM: {len(packages)} packages, {len(rpmish)} RPM-sourced, base present")
PYEOF

# --- vulnerability report, produced from the SPDX we publish --------------------
grype_config_args=()
if [[ -f "${RUNTIME_DIR}/.grype.yaml" ]]; then
    grype_config_args=(-c "${RUNTIME_DIR}/.grype.yaml")
fi

echo "Scanning ${stem}.spdx.json with Grype"
set +e
grype "${grype_config_args[@]}" "sbom:${stem}.spdx.json" \
    -o "json=${stem}.grype.json" \
    -o "sarif=${stem}.grype.sarif" \
    --fail-on high --only-fixed -q
grype_status=$?
set -e

if (( grype_status != 0 )); then
    echo "${runtime_id} (${arch}): Grype found a fixable High or Critical CVE" >&2
    python3 - "${stem}.grype.json" <<'PYEOF'
import json
import sys

report = json.load(open(sys.argv[1], encoding="utf-8"))
for match in (report.get("matches") or []):
    vuln = match.get("vulnerability") or {}
    if (vuln.get("severity") or "").lower() not in ("critical", "high"):
        continue
    artifact = match.get("artifact") or {}
    fix = ((vuln.get("fix") or {}).get("versions") or ["?"])[0]
    print(f"  {vuln.get('id')} {artifact.get('name')} {artifact.get('version')} -> {fix}")
PYEOF
    if (( best_effort )); then
        echo "  (best effort: recorded, not failing the build)" >&2
        grype_status=0
    fi
fi

# --- provenance ----------------------------------------------------------------
payload_manifest="${LAYER_ROOT}/runtime-manifest.json"
if [[ ! -f "${payload_manifest}" ]]; then
    echo "Missing ${payload_manifest}: rebuild the payload so the image records where it came from" >&2
    exit 1
fi

python3 - "${stem}" "${payload_manifest}" "${ARTIFACT_DIR}" "${CONTAINER_LOCAL_IMAGE}" <<'PYEOF'
import hashlib
import json
import os
import subprocess
import sys

stem, payload_manifest, artifact_dir, image = sys.argv[1:5]

def load(path):
    with open(path, encoding="utf-8") as handle:
        return json.load(handle)

def sha256(path):
    digest = hashlib.sha256()
    with open(path, "rb") as handle:
        for block in iter(lambda: handle.read(1 << 20), b""):
            digest.update(block)
    return digest.hexdigest()

def docker_format(template, ref):
    try:
        return subprocess.run(
            ["docker", "image", "inspect", "--format", template, ref],
            capture_output=True, text=True, check=True,
        ).stdout.strip()
    except subprocess.CalledProcessError:
        return ""

payload = load(payload_manifest)
container_record = {}
record_path = os.path.join(artifact_dir, "container.json")
if os.path.exists(record_path):
    container_record = load(record_path)

grype_path = stem + ".grype.json"
counts = {"Critical": 0, "High": 0, "Medium": 0, "Low": 0, "Negligible": 0, "Unknown": 0}
if os.path.exists(grype_path):
    for match in (load(grype_path).get("matches") or []):
        severity = ((match.get("vulnerability") or {}).get("severity") or "Unknown").capitalize()
        counts[severity if severity in counts else "Unknown"] += 1

provenance = {
    "runtime_id": payload.get("runtime_id"),
    "arch": payload.get("arch"),
    "distribution_version": payload.get("distribution_version"),
    "upstream_archive_url": payload.get("upstream_archive_url"),
    "upstream_sha256": payload.get("upstream_sha256"),
    "base_image_ref": container_record.get("base_image_ref", ""),
    "base_image_digest": container_record.get("base_image_digest", ""),
    "image_digest": docker_format("{{.Id}}", image),
    "unpacked_size_bytes": container_record.get("unpacked_bytes", 0),
    "stig_verification": {
        "user": container_record.get("user", ""),
        "package_managers_removed": container_record.get("package_managers_removed", False),
        "rpm_db_present": container_record.get("rpm_db_present", False),
        "read_only_rootfs_verified": container_record.get("read_only_rootfs_verified", False),
    },
    "sbom_sha256": {
        "spdx": sha256(stem + ".spdx.json") if os.path.exists(stem + ".spdx.json") else "",
        "cdx": sha256(stem + ".cdx.json") if os.path.exists(stem + ".cdx.json") else "",
    },
    "grype_summary": counts,
}

out = stem + ".provenance.json"
with open(out, "w", encoding="utf-8") as handle:
    json.dump(provenance, handle, indent=2, sort_keys=True)
    handle.write("\n")
print(f"Provenance: {out}")
print(f"CVEs: critical={counts['Critical']} high={counts['High']} medium={counts['Medium']} low={counts['Low']}")
PYEOF

if [[ -n "${GITHUB_STEP_SUMMARY:-}" ]]; then
    python3 - "${stem}.provenance.json" "${GITHUB_STEP_SUMMARY}" <<'PYEOF'
import json
import sys

provenance = json.load(open(sys.argv[1], encoding="utf-8"))
counts = provenance["grype_summary"]
base = "IronBank" if "registry1.dso.mil" in provenance["base_image_ref"] else "UBI-Fallback"
with open(sys.argv[2], "a", encoding="utf-8") as handle:
    handle.write(
        "| {runtime_id} | {arch} | {base} | {size:.1f} | {sbom} | {c}/{h}/{m}/{l} |\n".format(
            runtime_id=provenance["runtime_id"],
            arch=provenance["arch"],
            base=base,
            size=(provenance["unpacked_size_bytes"] or 0) / 1048576,
            sbom="spdx+cdx",
            c=counts["Critical"], h=counts["High"], m=counts["Medium"], l=counts["Low"],
        )
    )
PYEOF
fi

echo "Compliance bundle for ${runtime_id} (${arch}) written to ${compliance_dir}"
exit "${grype_status}"
