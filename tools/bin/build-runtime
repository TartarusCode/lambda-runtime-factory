#!/bin/bash
set -euo pipefail

source "$(dirname "$0")/_common.sh"

runtime_id=$(common::require_runtime_id "${1:-}")
arch=$(common::require_arch "${2:-}")
common::load_runtime_env "${runtime_id}" "${arch}"

checksum_for() {
    awk -v pkg="${CHECKSUM_NAME}" '{ sub(/\r$/, "", $2); if ($2 == pkg) print $1 }' "${CHECKSUM_FILE}"
}

verify_sha256() {
    local archive_path=$1
    local expected
    expected=$(checksum_for)

    if [[ -z "${expected}" ]]; then
        echo "Missing checksum for ${CHECKSUM_NAME} in ${CHECKSUM_FILE}" >&2
        exit 1
    fi

    if type -P sha256sum >/dev/null; then
        echo "${expected}  ${archive_path}" | sha256sum --check --status
    else
        local actual
        actual=$(shasum -a 256 "${archive_path}" | awk '{ print $1 }')
        [[ "${actual}" == "${expected}" ]]
    fi
}

strip_debug_symbols() {
    local root=$1
    # Symbols are not needed to execute anything, and upstream ships plenty of
    # them. Only real ELF objects are touched: strip would refuse a text file, and
    # on a host whose architecture differs from the target it refuses too — both
    # are logged and skipped rather than failing the build.
    python3 - "${root}" <<'PYEOF'
import os
import subprocess
import sys

root = sys.argv[1]
stripped = skipped = failed = saved = 0
for dirpath, _dirnames, filenames in os.walk(root):
    for name in filenames:
        if ".so" not in name:
            continue
        path = os.path.join(dirpath, name)
        try:
            with open(path, "rb") as handle:
                if handle.read(4) != b"\x7fELF":
                    skipped += 1
                    continue
            before = os.path.getsize(path)
            result = subprocess.run(
                ["strip", "--strip-unneeded", path],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
        except OSError:
            skipped += 1
            continue
        if result.returncode == 0:
            stripped += 1
            saved += max(0, before - os.path.getsize(path))
        else:
            failed += 1
print(
    f"strip: {stripped} ELF objects stripped ({saved} bytes saved), "
    f"{skipped} non-ELF skipped, {failed} refused (cross-arch or already stripped)"
)
PYEOF
}

strip_elf_files() {
    # Like strip_debug_symbols, but for known-binary directories (a Go or Rust bin
    # tree) where the names carry no ".so" to filter on.
    local dir
    for dir in "$@"; do
        [[ -d "${dir}" ]] || continue
        python3 - "${dir}" <<'PYEOF'
import os
import subprocess
import sys

root = sys.argv[1]
stripped = skipped = failed = saved = 0
for dirpath, _dirnames, filenames in os.walk(root):
    for name in filenames:
        path = os.path.join(dirpath, name)
        if os.path.islink(path):
            continue
        try:
            with open(path, "rb") as handle:
                if handle.read(4) != b"\x7fELF":
                    skipped += 1
                    continue
            before = os.path.getsize(path)
            # An executable needs no symbol table to run; a shared object does,
            # because the dynamic linker resolves through .dynsym, which
            # --strip-all would remove.
            flags = "--strip-unneeded" if ".so" in name else "--strip-all"
            result = subprocess.run(
                ["strip", flags, path],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
        except OSError:
            skipped += 1
            continue
        if result.returncode == 0:
            stripped += 1
            saved += max(0, before - os.path.getsize(path))
        else:
            failed += 1
print(f"strip {root}: {stripped} ELF objects stripped ({saved} bytes saved), "
      f"{skipped} non-ELF skipped, {failed} refused")
PYEOF
    done
}

# Replace the shell bootstrap with a statically linked launcher for the families
# whose bootstrap is a `#!/bin/sh` exec wrapper.
#
# A distroless image has no /bin/sh, so the wrapper can only work on
# provided.al2023. The launcher is the same exec without a shell, and it works in
# both places. It is compiled per target arch; when the build host is a different
# architecture (a local arm64 build on an x86 host) the script stays in place and
# the build warns, because the resulting image could not run it anyway.
install_native_bootstrap() {
    case "${RUNTIME_FAMILY}" in
        go-toolchain | rust-musl) ;;
        *) return 0 ;;
    esac

    local launcher_src="${REPO_ROOT}/tools/launcher/bootstrap.c"
    if [[ ! -f "${launcher_src}" ]]; then
        echo "::warning::missing launcher source ${launcher_src}; keeping the shell bootstrap" >&2
        return 0
    fi

    local expected_machine
    case "${ARCH}" in
        x86_64) expected_machine="x86_64" ;;
        arm64) expected_machine="aarch64" ;;
        *) echo "::warning::unknown arch ${ARCH}; keeping the shell bootstrap" >&2; return 0 ;;
    esac

    if [[ "$(uname -m)" != "${expected_machine}" ]]; then
        echo "::warning::host $(uname -m) cannot link a ${ARCH} launcher; keeping the shell bootstrap for this cross-arch build" >&2
        return 0
    fi
    if ! type -P cc >/dev/null; then
        echo "::warning::no C compiler; keeping the shell bootstrap" >&2
        return 0
    fi

    local output="${LAYER_ROOT}/${BOOTSTRAP_OUTPUT}"
    local tmp_output="${output}.compiled"
    if ! cc -O2 -static -s \
        -DRUNTIME_DIR_NAME="\"${RUNTIME_DIR_NAME}\"" \
        -o "${tmp_output}" "${launcher_src}"; then
        rm -f "${tmp_output}"
        echo "::warning::could not compile the native bootstrap; keeping the shell bootstrap" >&2
        return 0
    fi

    if [[ "$(head -c 4 "${tmp_output}")" != $'\x7fELF' ]]; then
        rm -f "${tmp_output}"
        echo "::warning::compiled bootstrap is not an ELF binary; keeping the shell bootstrap" >&2
        return 0
    fi

    mv "${tmp_output}" "${output}"
    chmod +x "${output}"
    echo "Installed the native bootstrap for ${RUNTIME_DIR_NAME} (${ARCH}) at ${output}"
}

# Sum of the regular files under a directory: what the deployment-package budget
# counts (the zip's unzipped size).
payload_bytes() {
    python3 - "$1" <<'PYEOF'
import os
import sys

total = 0
for dirpath, _dirnames, filenames in os.walk(sys.argv[1]):
    for name in filenames:
        path = os.path.join(dirpath, name)
        if os.path.islink(path):
            continue
        try:
            total += os.path.getsize(path)
        except OSError:
            pass
print(total)
PYEOF
}

# Precompile the interpreter's standard library to bytecode.
#
# Python parses and compiles every module it imports; shipping the .pyc files
# moves that work out of the Lambda init path.
#
# Off by default, because it was measured and did not pay: on pypy311 x86_64
# (n=12 cold starts each) the init time was 1693 ms without bytecode and 1713 ms
# with it, while the payload grew from 90.3 MB to 106.5 MB — the interpreter's own
# startup, not module compilation, dominates. It stays as an opt-in
# (PRECOMPILE_BYTECODE=1) for a family where imports are the bottleneck, and any
# runtime close to the 250 MB ceiling keeps its sources regardless.
#
# The payload's own interpreter must do the compiling: a host CPython writes
# bytecode with a different magic number, which PyPy and GraalPy refuse to load.
compile_bytecode() {
    local root=$1
    if [[ "${PRECOMPILE_BYTECODE:-0}" != "1" ]]; then
        return 0
    fi

    local interpreter
    interpreter=$(python3 - "${CONTAINER_ENTRYPOINT:-[]}" "${LAYER_ROOT}" <<'PYEOF'
import json
import sys

entrypoint = json.loads(sys.argv[1] or "[]")
layer_root = sys.argv[2].rstrip("/")
first = entrypoint[0] if entrypoint else ""
print(layer_root + first[len("/opt"):] if first.startswith("/opt/") else "")
PYEOF
)
    if [[ -z "${interpreter}" || ! -x "${interpreter}" ]]; then
        echo "::warning::no interpreter in the payload to precompile bytecode with; skipping" >&2
        return 0
    fi

    local expected_machine
    case "${ARCH}" in
        x86_64) expected_machine="x86_64" ;;
        arm64) expected_machine="aarch64" ;;
        *) return 0 ;;
    esac
    if [[ "$(uname -m)" != "${expected_machine}" ]]; then
        echo "::warning::host $(uname -m) cannot run the ${ARCH} interpreter; skipping bytecode precompilation" >&2
        return 0
    fi

    local before after snapshot
    before=$(payload_bytes "${root}")
    snapshot=$(mktemp)
    find "${root}" -type f -name '*.pyc' -print > "${snapshot}"

    if ! "${interpreter}" -m compileall -b -q -f --invalidation-mode=unchecked-hash "${root}" >/dev/null 2>&1; then
        echo "::warning::${runtime_id}: compileall could not compile every file (the sources stay in place)" >&2
    fi

    after=$(payload_bytes "${root}")
    echo "bytecode: $(find "${root}" -type f -name '*.pyc' | wc -l) .pyc files, $(( (after - before) / 1024 )) KiB added"

    if [[ "${LAYER_PUBLISHABLE}" == "true" && "${after}" -ge "${MAX_UNZIPPED_BYTES:-262144000}" ]]; then
        local removed
        removed=$(python3 - "${snapshot}" "${root}" <<'PYEOF'
import os
import sys

keep = set(open(sys.argv[1], encoding="utf-8").read().splitlines())
root = sys.argv[2]
removed = 0
for dirpath, _dirnames, filenames in os.walk(root):
    for name in filenames:
        if not name.endswith(".pyc"):
            continue
        path = os.path.join(dirpath, name)
        if path not in keep:
            os.unlink(path)
            removed += 1
print(removed)
PYEOF
)
        echo "::warning::${runtime_id} would exceed ${MAX_UNZIPPED_BYTES} bytes with precompiled bytecode; removed ${removed} generated .pyc files" >&2
    fi
    rm -f "${snapshot}"
}

# Trim a payload to what the runtime actually needs at execution time.
#
# The 250 MB deployment-package ceiling is on *unzipped* bytes, and upstream
# distributions ship stdlib test suites, GUI toolkits, headers, static archives
# and build-time-only components that a Lambda function never loads.
#
# Rule: prune, never rewrite. Package metadata that vulnerability scanning uses to
# identify a component — `*.dist-info`, `*.egg-info`, `*.json` manifests, license
# and version files — is never removed here, and the audit runs *after* this so it
# scans exactly what ships. Set SLIM_LAYER=0 to package the upstream payload as
# extracted, which is how the byte counts before and after are compared.
slim_layer() {
    if [[ "${SLIM_LAYER:-1}" != "1" ]]; then
        echo "Slimming disabled (SLIM_LAYER=${SLIM_LAYER:-1}): packaging the upstream payload as extracted."
        return 0
    fi

    local root="${LAYER_ROOT}/${RUNTIME_DIR_NAME}"
    if [[ ! -d "${root}" ]]; then
        return 0
    fi

    case "${RUNTIME_FAMILY}" in
        portable-pypy | graalpy)
            # Stdlib test suites, GUI toolkits and demos: the largest single win,
            # and nothing a function imports.
            find "${root}" -type d \
                \( -name test -o -name tests -o -name idle_test -o -name tkinter \
                   -o -name turtledemo -o -name ensurepip -o -name idlelib \
                   -o -name lib2to3 -o -name pydoc_data \) \
                -prune -exec rm -rf {} + 2>/dev/null || true
            # The compiled GUI module is the only thing that linked X11, Xft,
            # fontconfig and freetype; removing the package directory alone leaves
            # those shared libraries in the payload.
            find "${root}" -type f -name '_tkinter*.so' -delete 2>/dev/null || true
            find "${root}" -type d -name '_tkinter' -prune -exec rm -rf {} + 2>/dev/null || true
            # Portable PyPy bundles Tcl/Tk, and libtk is what pulled X11 and
            # fontconfig into an otherwise headless interpreter.
            find "${root}" \( -name 'libtcl*.so*' -o -name 'libtk*.so*' \) -delete 2>/dev/null || true
            # C headers, pkg-config files and static archives: the interpreter is
            # already built. `.debug` files are external symbol scripts, not code.
            find "${root}" -type f \( -name '*.a' -o -name '*.la' -o -name '*.debug' \) \
                -delete 2>/dev/null || true
            find "${root}" -type d \( -name include -o -name pkgconfig \) \
                -prune -exec rm -rf {} + 2>/dev/null || true
            # Documentation and build-time-only JVM components. License files stay:
            # this is a redistribution.
            find "${root}" -type d \( -name jmods -o -name man -o -name docs \) \
                -prune -exec rm -rf {} + 2>/dev/null || true
            strip_debug_symbols "${root}"
            # No locale data is pruned: these payloads ship none (glibc provides
            # it), and the bundled zoneinfo is 52 KiB that timezone-aware code
            # reads at run time.
            compile_bytecode "${root}"
            ;;
        go-toolchain)
            # The compiler and stdlib *are* the payload here, so only what a build
            # never reads is dropped: the top-level documentation and tooling
            # directories, the compiler test suite, test sources and `testdata`
            # fixtures.
            #
            # The pruning is depth-limited on purpose. `doc`, `api`, `misc` and
            # `obj` are *also* real package directories deeper in the tree
            # (`src/go/doc` is the stdlib `go/doc` package, `src/cmd/internal/obj`
            # is imported by the compiler), and `go build` compiles the standard
            # library from source, so removing them at any depth would break
            # builds of programs that import them.
            find "${root}" -maxdepth 1 -type d \
                \( -name doc -o -name test -o -name api -o -name misc -o -name obj \) \
                -prune -exec rm -rf {} + 2>/dev/null || true
            # `testdata` is never an importable package: it is the fixtures a
            # package's own tests read.
            find "${root}" -type d -name testdata -prune -exec rm -rf {} + 2>/dev/null || true
            find "${root}" -type f -name '*_test.go' -delete 2>/dev/null || true
            strip_elf_files "${root}/bin" "${root}/pkg/tool"
            ;;
        rust-musl)
            # Rust ships documentation, man pages and per-component metadata for
            # every target it supports; none of it is needed to run rustc.
            find "${root}" -type d \( -name rust-docs -o -name etc -o -name doc -o -name man \) \
                -prune -exec rm -rf {} + 2>/dev/null || true
            strip_debug_symbols "${root}"
            strip_elf_files "${root}/bin"
            ;;
        *)
            echo "No slimming rules for family '${RUNTIME_FAMILY}': packaging as extracted."
            ;;
    esac
}

rm -rf "${BUILD_DIR}"
mkdir -p "${LAYER_ROOT}" "${DOWNLOADS_DIR}" "${ARTIFACT_DIR}" "${WORK_DIR}"

cp "${BOOTSTRAP_SOURCE}" "${LAYER_ROOT}/${BOOTSTRAP_OUTPUT}"
chmod +x "${LAYER_ROOT}/${BOOTSTRAP_OUTPUT}"

if [[ ! -f "${ARCHIVE_PATH}" ]]; then
    curl --fail --location --proto '=https' --tlsv1.2 \
        --retry 5 --retry-all-errors --retry-delay 2 --retry-connrefused \
        --connect-timeout 30 \
        --output "${ARCHIVE_PATH}" "${ARCHIVE_URL}"
fi

verify_sha256 "${ARCHIVE_PATH}"

case "${ARCHIVE_NAME}" in
    *.tar.bz2)
        tar -xjf "${ARCHIVE_PATH}" -C "${WORK_DIR}"
        ;;
    *.tar.gz | *.tgz)
        tar -xzf "${ARCHIVE_PATH}" -C "${WORK_DIR}"
        ;;
    *.zip)
        unzip -qo "${ARCHIVE_PATH}" -d "${WORK_DIR}"
        ;;
    *)
        echo "Unsupported archive format: ${ARCHIVE_NAME}" >&2
        exit 1
        ;;
esac
if [[ -n "${BINARY_NAME:-}" && -f "${WORK_DIR}/${BINARY_NAME}" ]]; then
    mkdir -p "${LAYER_ROOT}/${RUNTIME_DIR_NAME}"
    mv "${WORK_DIR}/${BINARY_NAME}" "${LAYER_ROOT}/${RUNTIME_DIR_NAME}/${BINARY_NAME}"
else
    source_dir="${WORK_DIR}/${ARCHIVE_ROOT_DIR}"
    if [[ ! -d "${source_dir}" ]]; then
        # Upstream archives occasionally extract into a directory whose name
        # differs from the manifest's archive_root_dir (GraalPy asset
        # graalpy3.13-25.4.4-linux-amd64.tar.gz extracts to
        # graalpy3.13-25.4.4.1.1-linux-amd64). Fall back to the single
        # top-level directory when it is unambiguous.
        candidates=()
        for entry in "${WORK_DIR}"/*/; do
            [[ -d "${entry}" ]] && candidates+=("$(basename "${entry}")")
        done
        if [[ ${#candidates[@]} -eq 1 ]]; then
            echo "archive_root_dir '${ARCHIVE_ROOT_DIR}' not found; using extracted dir '${candidates[0]}'" >&2
            source_dir="${WORK_DIR}/${candidates[0]}"
        else
            echo "Expected extracted runtime at ${source_dir}; found ${#candidates[@]} top-level dir(s): ${candidates[*]:-none}" >&2
            exit 1
        fi
    fi
    mv "${source_dir}" "${LAYER_ROOT}/${RUNTIME_DIR_NAME}"
fi

mkdir -p "${LAYER_ROOT}/${HELPER_INSTALL_DIR}"
cp -R "${HELPER_SOURCE}" "${LAYER_ROOT}/${HELPER_INSTALL_DIR}/"

# Go and Rust bootstrap through `exec` in a shell today; replace that with a
# compiled launcher so the same payload runs on a shell-less distroless base.
install_native_bootstrap

# Before the audit and the zip, so both see exactly what ships.
slim_layer

if [[ "${BUILD_BEST_EFFORT_AUDIT:-1}" == "1" ]]; then
    RUNTIME_BUILD_IN_PROGRESS=1 bash "$(common::repo_root)/tools/bin/audit-runtime" --best-effort "${runtime_id}"
fi

# --- STIG rootless permissions --------------------------------------------------
#
# Lambda mounts a layer read-only and runs the function under an arbitrary
# non-root UID. Upstream archives carry whatever mode their packager used, and a
# file that is not world-readable (or a directory that is not world-traversable)
# is a permission-denied at first import — under a UID the build never saw.
# `a+rX` adds read for everyone and execute only where a directory (or a file
# that already had any execute bit) needs it, so no binary loses its mode.
chmod -R a+rX "${LAYER_ROOT}"
chmod a+rx "${LAYER_ROOT}/${BOOTSTRAP_OUTPUT}"

(
    cd "${LAYER_ROOT}"
    # Deterministic package. The SHA-256 of this zip is both the S3 object key and
    # the layer-reuse key (Content.CodeSha256), so identical inputs must produce
    # identical bytes. zip records every entry's mtime and, without -X, the uid/gid
    # it was written with — and cp/cp -R stamp their copies with "now" — so pin the
    # mtimes to the zip epoch in UTC and drop the ownership extras.
    TZ=UTC find . -exec touch -h -t 198001010000.00 {} +
    TZ=UTC zip -qrX "${PACKAGE_PATH}" .
)

# --- size accounting and the deployment-package gate ----------------------------
#
# AWS caps a deployment package at 250 MB *unzipped*, counting the function and
# all of its layers together. Discovering that at PublishLayerVersion costs a
# release run, so package_size.py measures the package, writes build-stats.json
# next to the artifact and fails here for anything that claims to be publishable.
python3 "${REPO_ROOT}/tools/runtime_lib/package_size.py" check \
    --runtime "${runtime_id}" \
    --arch "${arch}" \
    --package "${PACKAGE_PATH}" \
    --stats-out "${ARTIFACT_DIR}/build-stats.json" \
    --publishable "${LAYER_PUBLISHABLE:-true}" \
    --max-unzipped-bytes "${MAX_UNZIPPED_BYTES:-262144000}" \
    --warn-unzipped-bytes "${WARN_UNZIPPED_BYTES:-209715200}"

# The row belongs in the job summary. The composite action defers it so the
# container image size can be added after the image is built; a standalone build
# writes it immediately.
if [[ -n "${GITHUB_STEP_SUMMARY:-}" && "${LAMBDA_RUNTIME_SUMMARY_DEFERRED:-0}" != "1" ]]; then
    python3 "${REPO_ROOT}/tools/runtime_lib/package_size.py" summary \
        --runtime "${runtime_id}" \
        --arch "${arch}" \
        --summary-file "${GITHUB_STEP_SUMMARY}"
fi

if [[ -n "${EXPORT_ARTIFACT_DIR}" ]]; then
    mkdir -p "${EXPORT_ARTIFACT_DIR}/${RUNTIME_ID}"
    cp "${PACKAGE_PATH}" "${EXPORT_ARTIFACT_DIR}/${RUNTIME_ID}/"
fi

echo "Built ${runtime_id} runtime package at ${PACKAGE_PATH}"
