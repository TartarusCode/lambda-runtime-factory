#!/bin/bash
# Combine the per-arch images of each variant into one multi-arch tag, per
# registry.
#
# A manifest list cannot be built from an image that does not exist, so this runs
# after both architectures have pushed. Every registry in the manifest gets the
# same tags, and a partial dispatch (one arch) leaves the per-arch tags alone with
# a notice rather than failing.
#
#   merge-container-tags <runtime_id>
#
# Tags per variant: <version>, the version line, and a moving tag on a tagged
# release — `latest` for the standard image, `debug` for the debug one.
set -euo pipefail

source "$(dirname "$0")/_common.sh"

runtime_id=$(common::require_runtime_id "${1:-}")
common::load_runtime_env "${runtime_id}" "${ARCH:-x86_64}" standard

soci=0
for argument in "${@:2}"; do
    case "${argument}" in
        --soci) soci=1 ;;
        *) echo "Unknown option: ${argument}" >&2; exit 2 ;;
    esac
done

tag="${CONTAINER_TAG}"
line="${VERSION_LINE}"

mapfile -t registries < <(python3 -c 'import json,sys
for registry in json.loads(sys.argv[1]): print(registry)' "${CONTAINER_REGISTRIES_OVERRIDE:-${CONTAINER_REGISTRIES}}")
mapfile -t variants < <(bash "$(dirname "$0")/container-variants" "${runtime_id}" x86_64)

for registry in "${registries[@]}"; do
    image="${registry}/${RUNTIME_ID}"
    for variant in "${variants[@]}"; do
        if [[ "${variant}" == "debug" ]]; then
            suffix="-debug"
            moving="debug"
        else
            suffix=""
            moving="latest"
        fi

        arm_tag="${image}:${tag}-arm64${suffix}"
        if ! docker buildx imagetools inspect "${arm_tag}" >/dev/null 2>&1; then
            echo "::notice::${runtime_id} (${variant}): no ${arm_tag}; leaving the per-arch tags as published"
            continue
        fi

        tags=(--tag "${image}:${tag}${suffix}" --tag "${image}:${line}${suffix}")
        # Moving `latest`/`debug` is only meaningful for a tagged release: a
        # replayed older dispatch must not roll the moving tag backwards.
        if [[ "${GITHUB_REF_TYPE:-}" == "tag" ]]; then
            tags+=(--tag "${image}:${moving}")
        fi

        echo "Merging ${image}:${tag}${suffix} from the two per-arch images"
        docker buildx imagetools create "${tags[@]}" \
            "${image}:${tag}-amd64${suffix}" "${arm_tag}"

        if [[ -n "${GITHUB_STEP_SUMMARY:-}" ]]; then
            {
                echo "### Multi-arch image: ${runtime_id} (${variant})"
                echo
                echo '```'
                docker buildx imagetools inspect "${image}:${tag}${suffix}"
                echo '```'
                echo
            } >> "${GITHUB_STEP_SUMMARY}"
        fi
    done

    # The SOCI-enabled images merge the same way, but they are indexes rather than
    # image manifests: buildx flattens each one's two entries into the list, so the
    # result carries the image manifest and its index for every architecture.
    if (( soci )); then
        soci_arm="${image}:${tag}-arm64${CONTAINER_SOCI_SUFFIX}"
        if ! docker buildx imagetools inspect "${soci_arm}" >/dev/null 2>&1; then
            echo "::notice::${runtime_id} (soci): no ${soci_arm}; leaving the per-arch SOCI images as published"
            continue
        fi

        # No moving tag on purpose: a SOCI Index Manifest v2 image cannot have its
        # index added or removed, so a function pinned to a moving tag would change
        # what it runs the moment another release moved it.
        echo "Merging ${image}:${tag}${CONTAINER_SOCI_SUFFIX} from the two per-arch SOCI images"
        docker buildx imagetools create \
            --tag "${image}:${tag}${CONTAINER_SOCI_SUFFIX}" \
            --tag "${image}:${line}${CONTAINER_SOCI_SUFFIX}" \
            "${image}:${tag}-amd64${CONTAINER_SOCI_SUFFIX}" "${soci_arm}"

        if [[ -n "${GITHUB_STEP_SUMMARY:-}" ]]; then
            {
                echo "### Multi-arch SOCI-enabled image: ${runtime_id}"
                echo
                echo '```'
                docker buildx imagetools inspect "${image}:${tag}${CONTAINER_SOCI_SUFFIX}"
                echo '```'
                echo
            } >> "${GITHUB_STEP_SUMMARY}"
        fi
    fi
done
