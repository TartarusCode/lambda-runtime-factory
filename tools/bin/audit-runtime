#!/bin/bash
set -euo pipefail

source "$(dirname "$0")/_common.sh"
# Shared runtime environment helpers.

best_effort=0
if [[ "${1:-}" == "--best-effort" ]]; then
    best_effort=1
    shift
fi

runtime_id=$(common::require_runtime_id "${1:-}")
arch=$(common::require_arch "${2:-}")
common::load_runtime_env "${runtime_id}" "${arch}"
if [[ "${RUNTIME_BUILD_IN_PROGRESS:-0}" == "1" ]]; then
    target_dir="${LAYER_ROOT}"
    if [[ ! -d "${target_dir}" ]]; then
        echo "Expected extracted runtime at ${target_dir}" >&2
        exit 1
    fi
else
    common::ensure_runtime_built "${runtime_id}" "${arch}"
    target_dir="${LAYER_ROOT}"
    if [[ ! -d "${target_dir}" ]]; then
        echo "Expected extracted runtime at ${target_dir}" >&2
        exit 1
    fi
fi

trivy_ignore="${RUNTIME_DIR}/.trivyignore"
trivy_ignore_args=()
if [[ -f "${trivy_ignore}" ]]; then
    trivy_ignore_args=(--ignorefile "${trivy_ignore}")
fi

if type -P trivy >/dev/null; then
    trivy fs --cache-dir "${TRIVY_CACHE_DIR:-${HOME}/.cache/trivy}" --quiet --severity HIGH,CRITICAL --exit-code 1 "${trivy_ignore_args[@]}" "${target_dir}"
    exit 0
fi

if type -P grype >/dev/null; then
    grype "dir:${target_dir}" --fail-on high --only-fixed
    exit 0
fi

if type -P docker >/dev/null; then
    docker_extra_args=()
    if [[ -f "${trivy_ignore}" ]]; then
        docker_extra_args=(-v "${trivy_ignore}:/trivyignore:ro")
        trivy_ignore_args=(--ignorefile /trivyignore)
    fi
    docker run --rm \
        -v "${target_dir}:/scan:ro" \
        -v "${TRIVY_CACHE_DIR:-${HOME}/.cache/trivy}:/root/.cache/trivy" \
        "${docker_extra_args[@]}" \
        aquasec/trivy:latest fs --quiet --severity HIGH,CRITICAL --exit-code 1 "${trivy_ignore_args[@]}" /scan
    exit 0
fi

message="Install trivy, grype, or docker to perform runtime vulnerability scanning"
if (( best_effort )); then
    echo "${message}" >&2
    exit 0
fi

echo "${message}" >&2
exit 1
