#!/bin/bash
set -euo pipefail

source "$(dirname "$0")/_common.sh"

best_effort=0
if [[ "${1:-}" == "--best-effort" ]]; then
    best_effort=1
    shift
fi

runtime_id=$(common::require_runtime_id "${1:-}")
arch=$(common::require_arch "${2:-}")
common::load_runtime_env "${runtime_id}" "${arch}"
if [[ "${RUNTIME_BUILD_IN_PROGRESS:-0}" == "1" ]]; then
    target_dir="${LAYER_ROOT}"
    if [[ ! -d "${target_dir}" ]]; then
        echo "Expected extracted runtime at ${target_dir}" >&2
        exit 1
    fi
else
    common::ensure_runtime_built "${runtime_id}" "${arch}"
    target_dir="${LAYER_ROOT}"
    if [[ ! -d "${target_dir}" ]]; then
        echo "Expected extracted runtime at ${target_dir}" >&2
        exit 1
    fi
fi

grype_config="${RUNTIME_DIR}/.grype.yaml"
grype_config_args=()
if [[ -f "${grype_config}" ]]; then
    grype_config_args=(-c "${grype_config}")
fi

if type -P grype >/dev/null; then
    grype "${grype_config_args[@]}" -q --fail-on high --only-fixed "dir:${target_dir}"
    exit 0
fi

message="Install grype to perform runtime vulnerability scanning: https://github.com/anchore/grype#installation"
if (( best_effort )); then
    echo "${message}" >&2
    exit 0
fi

echo "${message}" >&2
exit 1
