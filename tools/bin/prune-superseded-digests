#!/bin/bash
# Remove the untagged digests a tag refresh left behind, bottom-up.
#
#   prune-superseded-digests <runtime_id> [arch]
#                            [--superseded-digest sha256:...]...
#                            [--grace-days N] [--registry <registry>]... [--delete]
#
# A security refresh pushes new bytes over `<version>-<arch>`, so the manifest that was
# there — and the five referrers attached to it — become untagged. They are still
# pullable by digest, so the unpatched image stays reachable and its blobs stay billed
# until something removes them. This removes them, and only them.
#
# Dry run by default; `--delete` is the explicit opt-in, and it never removes a digest
# it cannot prove is unreferenced.
#
# Never a candidate: a digest a tag points at, a platform manifest inside an active
# index, and any referrer attached to those digests. Everything else is a superseded
# orphan. Orphans are enumerated from the registry where an API can list untagged
# images (ECR Public, via `describe-images`), and otherwise they come from
# `--superseded-digest`, which is what a refresh passes for the digest it replaced.
#
# Deletion is bottom-up — referrers first, then the subject. Deleting the subject first
# leaves its referrers unreachable by discovery, so they can no longer be found to
# remove. Both go through common::delete_referrer, which falls back to the ECR Public
# API where a direct manifest DELETE is refused.
set -euo pipefail

source "$(dirname "$0")/_common.sh"

runtime_id=$(common::require_runtime_id "${1:-}")
arch=$(common::require_arch "${2:-}")
shift || true
shift || true

delete=0
grace_days=7
explicit=()
registries_override=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --superseded-digest) explicit+=("${2:-}"); shift 2 ;;
        --grace-days) grace_days=${2:-7}; shift 2 ;;
        --registry) registries_override+=("${2:-}"); shift 2 ;;
        --delete) delete=1; shift ;;
        *) echo "Unknown option: $1" >&2; exit 2 ;;
    esac
done

common::load_runtime_env "${runtime_id}" "${arch}"

if (( ${#registries_override[@]} )); then
    registries=("${registries_override[@]}")
else
    mapfile -t registries < <(python3 -c 'import json,sys
for registry in json.loads(sys.argv[1]): print(registry)' "${CONTAINER_REGISTRIES_OVERRIDE:-${CONTAINER_REGISTRIES:-[]}}")
fi

work=$(common::temp_root)/prune-superseded
mkdir -p "${work}"

failed=0
for registry in "${registries[@]}"; do
    repository="${registry}/${RUNTIME_ID}"
    slug=$(printf '%s' "${registry}" | tr '/:' '__')
    facts="${work}/facts-${slug}.json"
    plan_input="${work}/tags-${slug}.tsv"
    : > "${plan_input}"

    if ! oras repo tags "${repository}" > "${work}/tags-${slug}.txt" 2>/dev/null; then
        echo "::notice::${repository}: tags are not readable with the current credentials; nothing to prune here"
        continue
    fi

    # Every digest a tag points at, plus every platform manifest inside an index and
    # every referrer of those. This is the protected set: a tag is the published
    # contract, and an index's children are what a `docker pull` resolves to.
    while read -r name; do
        [[ -n "${name}" ]] || continue
        digest=$(common::remote_manifest_digest "${repository}:${name}")
        [[ -n "${digest}" ]] || continue
        printf '%s\t%s\n' "${name}" "${digest}" >> "${plan_input}"
        children=$(oras manifest fetch "${repository}@${digest}" 2>/dev/null \
            | python3 -c 'import json, sys
try:
    document = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for manifest in document.get("manifests") or []:
    if manifest.get("digest"):
        print(manifest["digest"])' || true)
        while read -r child; do
            [[ -n "${child}" ]] || continue
            printf '%s\t%s\n' "${name} child" "${child}" >> "${plan_input}"
            oras discover --format json "${repository}@${child}" 2>/dev/null \
                | python3 -c 'import json, sys
try:
    document = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for referrer in document.get("referrers") or []:
    if referrer.get("digest"):
        print(referrer["digest"])' 2>/dev/null \
                | while read -r referrer; do
                    [[ -n "${referrer}" ]] || continue
                    printf '%s\t%s\n' "${name} referrer of child" "${referrer}" >> "${plan_input}"
                done
        done <<< "${children}"
        oras discover --format json "${repository}@${digest}" 2>/dev/null \
            | python3 -c 'import json, sys
try:
    document = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for referrer in document.get("referrers") or []:
    if referrer.get("digest"):
        print(referrer["digest"])' 2>/dev/null \
            | while read -r referrer; do
                [[ -n "${referrer}" ]] || continue
                printf '%s\t%s\n' "${name} referrer" "${referrer}" >> "${plan_input}"
            done
    done < "${work}/tags-${slug}.txt"

    # Untagged orphan enumeration. ECR Public can list every digest it holds, with the
    # push time the grace period needs; GHCR has no equivalent for a token scoped to
    # this repository, so there the candidates are the ones a refresh named.
    : > "${work}/orphans-${slug}.tsv"
    case "${registry}" in
        public.ecr.aws/*)
            name=${repository#public.ecr.aws/}
            name=${name#*/}
            if type -P aws >/dev/null; then
                aws ecr-public describe-images \
                    --region "${ECR_PUBLIC_REGION:-us-east-1}" \
                    --repository-name "${name}" \
                    --paginate \
                    --query 'imageDetails[].[imageDigest,imagePushedAt]' \
                    --output text 2>/dev/null >> "${work}/orphans-${slug}.tsv" || true
            else
                echo "::notice::aws CLI is not installed; ${repository} can only prune the digests named on the command line"
            fi
            ;;
        *)
            echo "::notice::${registry} cannot list untagged images; pass --superseded-digest for a digest a refresh replaced"
            ;;
    esac

    python3 - "${facts}" "${repository}" "${plan_input}" \
        "${work}/orphans-${slug}.tsv" "${grace_days}" "${explicit[*]:-}" <<'PYEOF'
import json
import sys

facts_path, repository, protected_path, orphans_path, grace_days, explicit_text = sys.argv[1:7]

protected = {}
with open(protected_path, encoding="utf-8") as handle:
    for line in handle:
        name, _, digest = line.rstrip("\n").partition("\t")
        if digest:
            protected.setdefault(digest, name)

candidates = {}
for digest in [item for item in explicit_text.split() if item]:
    candidates[digest] = {"reason": "named on the command line", "pushed_at": ""}
with open(orphans_path, encoding="utf-8") as handle:
    for line in handle:
        parts = line.split()
        if not parts:
            continue
        digest = parts[0]
        pushed_at = parts[1] if len(parts) > 1 else ""
        candidates.setdefault(digest, {"reason": "untagged in the registry", "pushed_at": pushed_at})

with open(facts_path, "w", encoding="utf-8") as handle:
    json.dump(
        {
            "repository": repository,
            "protected": protected,
            "candidates": candidates,
            "explicit": [item for item in explicit_text.split() if item],
            "grace_days": int(grace_days),
        },
        handle,
        indent=2,
        sort_keys=True,
    )
PYEOF

    # The decision, in one place: a candidate is removed only when nothing protects
    # it. A young untagged digest is kept — a tag can be pushed before its index or
    # referrers are attached, and deleting mid-publish would leave a broken release.
    decision=$(python3 - "${facts}" <<'PYEOF'
import json
import sys
from datetime import datetime, timedelta, timezone

facts = json.load(open(sys.argv[1], encoding="utf-8"))
protected = facts.get("protected") or {}
candidates = facts.get("candidates") or {}
explicit = set(facts.get("explicit") or [])
grace = timedelta(days=int(facts.get("grace_days") or 0))
now = datetime.now(timezone.utc)

def too_young(stamp):
    if not stamp:
        return False
    try:
        pushed = datetime.fromisoformat(str(stamp).replace("Z", "+00:00"))
    except ValueError:
        return False
    return now - pushed < grace

for digest in sorted(candidates):
    if digest in protected:
        print(f"keep\t{digest}\t{protected[digest]}")
        continue
    if digest not in explicit and too_young(candidates[digest].get("pushed_at")):
        print(f"keep\t{digest}\tyounger than the {facts.get('grace_days')}-day grace period")
        continue
    print(f"delete\t{digest}\t{candidates[digest].get('reason', 'superseded')}")
PYEOF
)
    while IFS=$'\t' read -r action digest detail; do
        [[ -n "${digest:-}" ]] || continue
        if [[ "${action}" == "keep" ]]; then
            echo "keep   ${digest} (${detail})"
            continue
        fi
        echo "delete ${digest} (${detail})"
        if (( ! delete )); then
            continue
        fi
        # Referrers first: once the subject is gone, discovery cannot find them.
        oras discover --format json "${repository}@${digest}" 2>/dev/null \
            | python3 -c 'import json, sys
try:
    document = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for referrer in document.get("referrers") or []:
    if referrer.get("digest"):
        print(referrer["digest"])' 2>/dev/null \
            | while read -r referrer; do
                [[ -n "${referrer}" ]] || continue
                if common::delete_referrer "${repository}" "${referrer}"; then
                    echo "  removed referrer ${referrer}"
                else
                    echo "::notice::${repository}: referrer ${referrer} could not be removed with this token"
                fi
            done
        if common::delete_referrer "${repository}" "${digest}"; then
            echo "  removed ${digest}"
        else
            echo "::notice::${repository}: ${digest} could not be removed with this token (public.ecr.aws needs the ECR Public API; ghcr.io needs delete:packages)"
        fi
    done <<< "${decision}"
done

if (( delete )); then
    echo "Superseded digests pruned; see the notices above for anything a token could not remove."
else
    echo "Dry run: pass --delete to remove the digests marked above."
fi
exit 0