#!/bin/bash
set -euo pipefail

source "$(dirname "$0")/_common.sh"

runtime_id=$(common::require_runtime_id "${1:-}")
arch=$(common::require_arch "${2:-}")

bash "$(common::repo_root)/tools/bin/local-build-runtime" "${runtime_id}" "${arch}"
common::load_runtime_env "${runtime_id}" "${arch}"

mkdir -p "${LOCAL_INVOKE_DIR}"
cp -R "${LOCAL_SOURCE_DIR}/." "${LOCAL_INVOKE_DIR}/"
cp -R "${LOCAL_LAYER_DIR}/${RUNTIME_DIR_NAME}" "${LOCAL_INVOKE_DIR}/"

if [[ "${BOOTSTRAP_SOURCE}" == *.py3 ]]; then
    cp "${BOOTSTRAP_SOURCE}" "${LOCAL_INVOKE_DIR}/bootstrap.py"
    interp_base=$(basename "$(head -1 "${BOOTSTRAP_SOURCE}" | sed 's|^#!||')")
    cat > "${LOCAL_INVOKE_DIR}/bootstrap" <<WRAPPER
#!/bin/sh
set -eu
export PYTHONPATH="\${LAMBDA_TASK_ROOT}/${HELPER_INSTALL_DIR}:\${LAMBDA_TASK_ROOT}:\${PYTHONPATH:-}"
exec "\${LAMBDA_TASK_ROOT}/${RUNTIME_DIR_NAME}/bin/${interp_base}" "\${LAMBDA_TASK_ROOT}/bootstrap.py"
WRAPPER
else
    sed "s|/opt/|/var/task/|g" "${BOOTSTRAP_SOURCE}" > "${LOCAL_INVOKE_DIR}/bootstrap"
fi
chmod +x "${LOCAL_INVOKE_DIR}/bootstrap"

python3 - "${LOCAL_INVOKE_TEMPLATE}" "${LOCAL_INVOKE_DIR}" "${LOCAL_FUNCTION_NAME}" "${LOCAL_HANDLER}" <<'PY'
import sys
from pathlib import Path

template_path = Path(sys.argv[1])
code_uri = sys.argv[2]
function_name = sys.argv[3]
handler = sys.argv[4]

template_path.write_text(
    "\n".join(
        [
            "AWSTemplateFormatVersion: '2010-09-09'",
            "Transform: AWS::Serverless-2016-10-31",
            "Description: \"Runtime local invoke template\"",
            "",
            "Resources:",
            f"  {function_name}:",
            "    Type: AWS::Serverless::Function",
            "    Properties:",
            f"      CodeUri: {code_uri}",
            f"      Handler: {handler}",
            "      Runtime: provided.al2023",
            "      Timeout: 10",
            "      MemorySize: 256",
            "",
        ]
    ),
    encoding="utf-8",
    newline="\n",
)
PY

invoke_output=$(sam local invoke "${LOCAL_FUNCTION_NAME}" --template-file "${LOCAL_INVOKE_TEMPLATE}" --event "${LOCAL_EVENT}" 2>&1) || true
echo "${invoke_output}"

if echo "${invoke_output}" | grep -qE "(Init failed|Invoke failed|Invoke DONE failed|exit status [1-9])"; then
    echo "Local invoke failed for ${runtime_id}" >&2
    exit 1
fi
