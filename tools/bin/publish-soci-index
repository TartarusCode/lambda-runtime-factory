#!/bin/bash
# Generate and publish AWS SOCI (Seekable OCI) indexes for a runtime's images.
#
# A SOCI index lets Lambda start a container image lazily: the microVM boots
# before the image has finished downloading and faults in only the blocks the
# runtime actually touches, which removes image size from the cold-start path.
# The index is an OCI artifact that refers to the image manifest, so it is
# generated after `merge-containers` has created the multi-arch tag.
#
# Lambda reads SOCI indexes from Amazon ECR. An image on a registry that is not
# ECR gets a notice and no index: publishing one there would be bytes nothing
# consumes.
#
#   publish-soci-index <runtime_id> [--push]
#
# Env: SOCI_VERSION (pinned), SOCI_USER / SOCI_PASSWORD for `soci push`,
#      SOCI_STORE_ROOT for the local content store.
set -euo pipefail

source "$(dirname "$0")/_common.sh"

push=0
positional=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --push) push=1; shift ;;
        -*) echo "Unknown option: $1" >&2; exit 2 ;;
        *) positional+=("$1"); shift ;;
    esac
done

runtime_id=$(common::require_runtime_id "${positional[0]:-}")
common::load_runtime_env "${runtime_id}" "${positional[1]:-x86_64}" standard

soci_version="${SOCI_VERSION:-v0.16.1}"
store_root="${SOCI_STORE_ROOT:-${BUILD_DIR}/soci-store}"
soci="${SOCI_BIN:-${DOWNLOADS_DIR}/soci-${soci_version}}"

if [[ ! -x "${soci}" ]]; then
    case "$(uname -m)" in
        x86_64) soci_arch=amd64 ;;
        aarch64 | arm64) soci_arch=arm64 ;;
        *) echo "no soci asset for $(uname -m)" >&2; exit 1 ;;
    esac
    asset="soci-snapshotter-${soci_version#v}-linux-${soci_arch}.tar.gz"
    url="https://github.com/awslabs/soci-snapshotter/releases/download/${soci_version}/${asset}"
    echo "Downloading ${asset} (${soci_version})"
    tmp=$(mktemp -d)
    curl --fail --location --proto '=https' --tlsv1.2 --retry 5 --retry-all-errors \
        --retry-delay 2 --connect-timeout 30 --output "${tmp}/${asset}" "${url}"
    tar -xzf "${tmp}/${asset}" -C "${tmp}"
    install -m 0755 "$(find "${tmp}" -type f -name soci -print -quit)" "${soci}"
    rm -rf "${tmp}"
fi

# The self-contained content store keeps blobs out of containerd, but it does not
# make the CLI containerd-free: `create` and `push` both resolve the image through
# containerd's image service (`internal.NewClient` -> `containerd.New(address)`),
# so a containerd that knows this image has to be reachable. Verified against
# v0.16.1: it dials /run/containerd/containerd.sock and fails with "permission
# denied" even with `--content-store soci`.
soci_store_args=(--content-store soci --root "${store_root}")
: "${CONTAINERD_ADDRESS:=/run/containerd/containerd.sock}"
: "${CONTAINERD_NAMESPACE:=default}"

containerd_help() {
    cat >&2 <<EOF
soci needs a containerd image service, not just a registry: \`create\` looks the
image up with containerd's ImageService and \`push\` reads it from the same client,
so --content-store only moves the blobs.

To run this:
  1. have containerd reachable at ${CONTAINERD_ADDRESS} (with access to the
     socket — on hosted runners it is root-owned, so run soci under sudo),
  2. import the image into that containerd, e.g.
     docker save ${CONTAINER_IMAGE}:${CONTAINER_TAG}${CONTAINER_TAG_SUFFIX} \
       | sudo ctr --address ${CONTAINERD_ADDRESS} -n ${CONTAINERD_NAMESPACE} images import - ,
  3. re-run this script.

\`soci convert --standalone\` avoids containerd entirely, but it reads and writes
OCI layouts: it produces the index locally and does not publish the referrer, so
it needs something like oras or crane to push. Nothing in the release does that
yet — see CONTRIBUTING.md.
EOF
}

# `soci push` needs registry credentials. Rather than putting a token in the
# workflow, mint one from the AWS role the job already assumed: ECR Public
# accepts the registry password from `aws ecr-public get-login-password`.
if [[ -z "${SOCI_PASSWORD:-}" ]] && type -P aws >/dev/null; then
    SOCI_PASSWORD=$(aws ecr-public get-login-password --region "${AWS_REGION:-us-east-1}" 2>/dev/null || true)
    if [[ -n "${SOCI_PASSWORD}" ]]; then
        SOCI_USER="${SOCI_USER:-AWS}"
    fi
fi

mapfile -t registries < <(python3 -c 'import json,sys
for registry in json.loads(sys.argv[1]): print(registry)' "${CONTAINER_REGISTRIES}")

job_summary() {
    [[ -n "${GITHUB_STEP_SUMMARY:-}" ]] || return 0
    {
        echo "#### SOCI index: ${runtime_id}"
        echo
        echo "- \`$1\`"
        echo
    } >> "${GITHUB_STEP_SUMMARY}"
}

for registry in "${registries[@]}"; do
    image="${registry}/${RUNTIME_ID}"
    case "${image}" in
        public.ecr.aws/* | *.dkr.ecr.*) ;;
        *)
            echo "${runtime_id}: ${image} is not an ECR registry; Lambda reads SOCI indexes from ECR, so no index is published there"
            continue
            ;;
    esac

    reference="${image}:${CONTAINER_TAG}${CONTAINER_TAG_SUFFIX}"
    echo "soci create --all-platforms ${reference}"
    # --all-platforms makes one index for the manifest list rather than for the
    # platform this runner happens to be.
    if ! create_output=$("${soci}" --address "${CONTAINERD_ADDRESS}" --namespace "${CONTAINERD_NAMESPACE}" \
        create "${soci_store_args[@]}" --all-platforms "${reference}" 2>&1); then
        printf '%s\n' "${create_output}" >&2
        if grep -qiE 'containerd.sock|connection error|permission denied|no such file' <<<"${create_output}"; then
            containerd_help
        fi
        exit 1
    fi
    printf '%s\n' "${create_output}"

    if (( push )); then
        if [[ -n "${SOCI_USER:-}" ]]; then
            echo "soci push --user ${SOCI_USER} ${reference}"
            "${soci}" --address "${CONTAINERD_ADDRESS}" --namespace "${CONTAINERD_NAMESPACE}" \
                push "${soci_store_args[@]}" --user "${SOCI_USER}:${SOCI_PASSWORD:-}" "${reference}"
        else
            echo "soci push ${reference}"
            "${soci}" --address "${CONTAINERD_ADDRESS}" --namespace "${CONTAINERD_NAMESPACE}" \
                push "${soci_store_args[@]}" "${reference}"
        fi
        job_summary "${reference}"
    else
        echo "Dry run: index created in ${store_root} for ${reference}; pass --push to publish it"
    fi
done
