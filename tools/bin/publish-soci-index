#!/bin/bash
# Publish a SOCI-enabled copy of one architecture's image.
#
# Lambda lazily loads a container image from Amazon ECR when the function runs on
# Lambda Managed Instances and its image URI points at a tag that carries a SOCI
# index. That is a *second* image, not the one we publish normally: SOCI Index
# Manifest v2 bundles the index into a new image — the original layers plus the
# index — so it has its own digest and its own tag. This publishes
# `<tag>-<arch>-soci`; `merge-container-tags --soci` combines the architectures.
#
#   publish-soci-index <runtime_id> [arch] [--push] [--force]
#
# A re-release of unchanged bytes publishes the same image, so the `-soci` tag that
# already indexes it is reused rather than converted and pushed again — a new SOCI
# index would be a new digest, and a new digest means a new signature and a new set
# of referrers for content that did not change. `--force` converts anyway.
#
# Containerd-free on purpose. `soci create` / `soci push` resolve the image through
# containerd's image service, which a runner that builds with Docker does not have;
# `soci convert --standalone` reads and writes OCI image layouts instead, and
# `oras` moves them between the layout and the registry. No root, no daemon.
#
# Env: SOCI_VERSION, ORAS_VERSION (both pinned), SOCI_BIN, ORAS_BIN overrides.
set -euo pipefail

source "$(dirname "$0")/_common.sh"

push=0
force=0
positional=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --push) push=1; shift ;;
        --force) force=1; shift ;;
        -*) echo "Unknown option: $1" >&2; exit 2 ;;
        *) positional+=("$1"); shift ;;
    esac
done

runtime_id=$(common::require_runtime_id "${positional[0]:-}")
common::load_runtime_env "${runtime_id}" "${positional[1]:-x86_64}" standard

soci_version="${SOCI_VERSION:-v0.16.1}"
oras_version="${ORAS_VERSION:-v1.3.6}"

case "$(uname -m)" in
    x86_64) tool_arch=amd64 ;;
    aarch64 | arm64) tool_arch=arm64 ;;
    *) echo "no soci/oras asset for $(uname -m)" >&2; exit 1 ;;
esac

# install_tool <url> <asset> <destination> <binary>
install_tool() {
    local url=$1 asset=$2 destination=$3 binary=$4 tmp
    echo "Downloading ${asset}"
    tmp=$(mktemp -d)
    curl --fail --location --proto '=https' --tlsv1.2 --retry 5 --retry-all-errors \
        --retry-delay 2 --connect-timeout 30 --output "${tmp}/${asset}" "${url}"
    tar -xzf "${tmp}/${asset}" -C "${tmp}"
    install -m 0755 "$(find "${tmp}" -type f -name "${binary}" -print -quit)" "${destination}"
    rm -rf "${tmp}"
}

soci="${SOCI_BIN:-${DOWNLOADS_DIR}/soci-${soci_version}}"
if [[ ! -x "${soci}" ]]; then
    asset="soci-snapshotter-${soci_version#v}-linux-${tool_arch}.tar.gz"
    install_tool \
        "https://github.com/awslabs/soci-snapshotter/releases/download/${soci_version}/${asset}" \
        "${asset}" "${soci}" soci
fi

oras="${ORAS_BIN:-${DOWNLOADS_DIR}/oras-${oras_version}}"
if [[ ! -x "${oras}" ]]; then
    asset="oras_${oras_version#v}_linux_${tool_arch}.tar.gz"
    install_tool \
        "https://github.com/oras-project/oras/releases/download/${oras_version}/${asset}" \
        "${asset}" "${oras}" oras
fi

workdir="${TEMP_ROOT}/soci/${CONTAINER_ARCH}"
layout="${workdir}/image"
converted="${workdir}/image-soci"

mapfile -t registries < <(common::soci_registries)

if [[ ${#registries[@]} -eq 0 ]]; then
    echo "no ECR registry in the manifest and SOCI_REGISTRIES is unset; Lambda reads SOCI indexes from ECR, so nothing is published"
    exit 0
fi

# A throwaway registry in a test is plain HTTP; ECR is not. The flags differ per
# direction, so keep them separate and decide per registry rather than guessing.
plain_flags() {  # plain_flags <registry>; sets PLAIN_SOURCE, PLAIN_DESTINATION, PLAIN_FETCH
    local host=${1%%/*}
    PLAIN_SOURCE=()
    PLAIN_DESTINATION=()
    PLAIN_FETCH=()
    if [[ "${host}" =~ ^(localhost|127\.0\.0\.1)(:[0-9]+)?$ ]]; then
        PLAIN_SOURCE=(--from-plain-http)
        PLAIN_DESTINATION=(--to-plain-http)
        PLAIN_FETCH=(--plain-http)
    fi
}

# The SOCI copy is an index whose two entries are the image manifest and the index
# manifest, cross-annotated, for this architecture only. If any of that is wrong
# the function would still start — just without the index it is supposed to carry —
# so the shape is checked rather than assumed.
verify_soci_index() {
    local reference=$1 file=$2
    fetch_index() {
        "${oras}" manifest fetch "${PLAIN_FETCH[@]}" "${reference}" > "${file}"
    }
    if ! common::retry 5 fetch_index; then
        echo "Could not read ${reference} back after 5 attempts" >&2
        exit 1
    fi
    python3 - "${CONTAINER_ARCH}" "${file}" <<'PY'
import json
import sys

arch, path = sys.argv[1], sys.argv[2]
with open(path, encoding="utf-8") as handle:
    document = json.load(handle)

entries = document.get("manifests") or []
if not entries:
    sys.exit(f"{path}: not an image index")


def annotation(entry, key):
    return (entry.get("annotations") or {}).get(key, "")


if not any(annotation(entry, "com.amazon.soci.index-digest") for entry in entries):
    sys.exit(f"{path}: no entry carries com.amazon.soci.index-digest")
if not any(annotation(entry, "com.amazon.soci.image-manifest-digest") for entry in entries):
    sys.exit(f"{path}: no entry carries com.amazon.soci.image-manifest-digest")

platforms = {(entry.get("platform") or {}).get("architecture") for entry in entries}
if platforms != {arch}:
    sys.exit(f"{path}: expected only {arch}, found {sorted(str(p) for p in platforms)}")

print(f"{arch}: {len(entries)} entries, image and index manifests paired")
PY
}

# reusable_soci_digest <soci_reference> <image_reference> <repository>
#
# Prints the digest of the existing `-soci` index when it already describes the
# image published right now, and returns non-zero when it does not. The identity
# check is on the *layers*, in order: `soci convert` rewrites the image config (it
# annotates it), so the SOCI copy always names a different image manifest than the
# one we pushed — the manifest digest can never match — while the layers are the
# bytes Lambda actually lazy-loads. Same layers ⇒ same lazy-loadable image ⇒ no
# reason to mint a new index digest.
reusable_soci_digest() {
    local soci_reference=$1 image_reference=$2 repository=$3
    local soci_digest subject
    soci_digest=$("${oras}" manifest fetch --descriptor "${PLAIN_FETCH[@]}" "${soci_reference}" 2>/dev/null \
        | python3 -c 'import json, sys
try:
    print(json.load(sys.stdin).get("digest", ""))
except Exception:
    pass')
    [[ -n "${soci_digest}" ]] || return 1

    subject=$("${oras}" manifest fetch "${PLAIN_FETCH[@]}" "${soci_reference}" 2>/dev/null \
        | python3 -c 'import json, sys
try:
    document = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for entry in document.get("manifests") or []:
    digest = (entry.get("annotations") or {}).get("com.amazon.soci.image-manifest-digest", "")
    if digest:
        print(digest)
        break')
    [[ -n "${subject}" ]] || return 1

    "${oras}" manifest fetch "${PLAIN_FETCH[@]}" "${image_reference}" \
        > "${workdir}/source-manifest.json" 2>/dev/null || return 1
    "${oras}" manifest fetch "${PLAIN_FETCH[@]}" "${repository}@${subject}" \
        > "${workdir}/soci-subject-manifest.json" 2>/dev/null || return 1

    python3 - "${workdir}/source-manifest.json" "${workdir}/soci-subject-manifest.json" <<'PY' || return 1
import json
import sys

source_path, soci_path = sys.argv[1:3]


def layers(path):
    with open(path, encoding="utf-8") as handle:
        document = json.load(handle)
    return [layer.get("digest", "") for layer in (document.get("layers") or [])]


source, soci = layers(source_path), layers(soci_path)
if not source or source != soci:
    sys.exit(1)
PY
    printf '%s' "${soci_digest}"
}

for registry in "${registries[@]}"; do
    image="${registry}/${RUNTIME_ID}"

    reference="${image}:${CONTAINER_TAG}-${CONTAINER_ARCH}"
    soci_reference="${reference}${CONTAINER_SOCI_SUFFIX}"
    plain_flags "${registry}"

    mkdir -p "${workdir}"

    # Reuse is checked before anything is pulled: converting costs a full image
    # unpack, and pushing would replace a digest that is already signed, attested
    # and referenced by whatever pinned it.
    if (( push )) && (( ! force )); then
        if existing_digest=$(reusable_soci_digest "${soci_reference}" "${reference}" "${image}"); then
            echo "Reusing ${soci_reference}: it already indexes ${reference} (${existing_digest})"
            common::record_container_digest soci_digests "${registry}" \
                "${soci_reference}" "${existing_digest}" true
            if [[ -n "${GITHUB_STEP_SUMMARY:-}" ]]; then
                {
                    echo "#### SOCI-enabled image: ${runtime_id} (${CONTAINER_ARCH})"
                    echo
                    echo "- \`${soci_reference}\`"
                    echo "- unchanged: reused index ${existing_digest}"
                    echo
                } >> "${GITHUB_STEP_SUMMARY}"
            fi
            continue
        fi
    fi

    rm -rf "${layout}" "${converted}"

    # One architecture at a time: a SOCI index describes a single image manifest,
    # and a per-arch tag is exactly one manifest, so nothing has to be resolved
    # per platform and the multi-arch tag is merged afterwards.
    #
    # `--platform` is not optional. buildx exports provenance attestations by
    # default, so the pushed per-arch tag is an OCI *index* holding the image
    # manifest plus an attestation manifest whose platform is `unknown/unknown`.
    # `oras cp --to-oci-layout` copies that index verbatim, and `soci convert
    # --standalone` then refuses the layout with "manifest should have proper
    # platform". Filtering the pull to this architecture drops the attestation
    # entry and leaves exactly the one manifest SOCI can convert.
    echo "Pulling ${reference} to an OCI layout"
    # The tag was pushed seconds ago, and a registry can resolve it before every
    # layer is readable, which surfaces as `not found` for a blob the manifest
    # names. Retry before concluding the image is missing.
    pull_image() {
        rm -rf "${layout}"
        "${oras}" cp "${PLAIN_SOURCE[@]}" --platform "linux/${CONTAINER_ARCH}" \
            --to-oci-layout "${reference}" "${layout}:${CONTAINER_TAG}"
    }
    if ! common::retry 5 pull_image; then
        echo "Could not pull ${reference} after 5 attempts" >&2
        exit 1
    fi

    echo "Converting ${reference} to a SOCI-enabled image"
    "${soci}" convert --standalone --format oci-dir "${layout}" "${converted}"

    index_digest=$(python3 -c 'import json,sys
print(json.load(open(sys.argv[1]))["manifests"][0]["digest"])' "${converted}/index.json")

    if (( ! push )); then
        echo "Dry run: SOCI-enabled image for ${reference} is in ${converted} (${index_digest}); pass --push to publish it"
        continue
    fi

    echo "Pushing ${soci_reference}"
    "${oras}" cp --from-oci-layout "${converted}@${index_digest}" "${PLAIN_DESTINATION[@]}" "${soci_reference}"
    verify_soci_index "${soci_reference}" "${workdir}/soci-index.json"

    # The pushed tag names a digest that only the registry can compute (the local
    # layout digest is the same bytes, but recording the served one is what a
    # consumer verifies against).
    published_digest=$("${oras}" manifest fetch --descriptor "${PLAIN_FETCH[@]}" "${soci_reference}" 2>/dev/null \
        | python3 -c 'import json, sys
try:
    print(json.load(sys.stdin).get("digest", ""))
except Exception:
    pass' || true)
    if [[ -n "${published_digest}" ]]; then
        common::record_container_digest soci_digests "${registry}" \
            "${soci_reference}" "${published_digest}" false
    else
        echo "::warning::${soci_reference} was pushed but its digest could not be read back" >&2
    fi

    if [[ -n "${GITHUB_STEP_SUMMARY:-}" ]]; then
        {
            echo "#### SOCI-enabled image: ${runtime_id} (${CONTAINER_ARCH})"
            echo
            echo "- \`${soci_reference}\`"
            echo "- index ${index_digest}"
            echo
        } >> "${GITHUB_STEP_SUMMARY}"
    fi
done
