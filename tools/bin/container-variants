#!/bin/bash
# Print the container variants a runtime publishes, one per line.
#
#   container-variants <runtime_id> <arch>
#
# Every runtime has a standard image; a distroless runtime also has a debug
# variant (the same payload on a base that carries a busybox shell). A build
# profile is already a shell image, so it has no second variant — callers loop
# over this list instead of hard-coding which families get one.
set -euo pipefail

source "$(dirname "$0")/_common.sh"

runtime_id=$(common::require_runtime_id "${1:-}")
arch=$(common::require_arch "${2:-}")
common::load_runtime_env "${runtime_id}" "${arch}" standard

echo standard
if [[ "${CONTAINER_DEBUG_ENABLED}" == "true" ]]; then
    echo debug
fi
