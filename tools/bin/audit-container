#!/bin/bash
# Scan a runtime's image with Grype.
#
# The payload scan (audit-runtime) covers the runtime bytes; this covers the image
# as it ships — base OS packages included — so a CVE in the base's glibc, OpenSSL
# or zlib cannot slip through just because the payload is clean. Same policy as the
# payload scan: high and above, fixed only.
#
# The RPM database is what makes this meaningful on a UBI9 base: a RHEL backport is
# matched through the installed package's release, which is exactly what a
# hand-copied `.so` would destroy.
set -euo pipefail

source "$(dirname "$0")/_common.sh"

best_effort=0
positional=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --best-effort) best_effort=1; shift ;;
        --ironbank) shift ;;  # no-op: every image is on the Iron Bank base
        -*) echo "Unknown option: $1" >&2; exit 2 ;;
        *) positional+=("$1"); shift ;;
    esac
done

runtime_id=$(common::require_runtime_id "${positional[0]:-}")
arch=$(common::require_arch "${positional[1]:-}")
common::load_runtime_env "${runtime_id}" "${arch}"

if ! docker image inspect "${CONTAINER_LOCAL_IMAGE}" >/dev/null 2>&1; then
    bash "$(common::repo_root)/tools/bin/build-container" "${runtime_id}" "${arch}"
    common::load_runtime_env "${runtime_id}" "${arch}"
fi

grype_config="${RUNTIME_DIR}/.grype.yaml"
grype_config_args=()
if [[ -f "${grype_config}" ]]; then
    grype_config_args=(-c "${grype_config}")
fi

if type -P grype >/dev/null; then
    grype "${grype_config_args[@]}" -q --fail-on high --only-fixed "docker:${CONTAINER_LOCAL_IMAGE}"
    exit 0
fi

message="Install grype to perform container vulnerability scanning: https://github.com/anchore/grype#installation"
if (( best_effort )); then
    echo "${message}" >&2
    exit 0
fi

echo "${message}" >&2
exit 1
